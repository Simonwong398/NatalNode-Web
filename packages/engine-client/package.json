{
  "name": "@natalnode/engine-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http-engine-client.ts",
      "node": "./dist/http-engine-client.js",
      "default": "./src/http-engine-client.ts"
    },
    "./mock": {
      "types": "./src/mock-engine-client.ts",
      "node": "./dist/mock-engine-client.js",
      "default": "./src/mock-engine-client.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@natalnode/contracts": "0.1.0",
    "@natalnode/test-fixtures": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
