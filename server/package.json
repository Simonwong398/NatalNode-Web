{
  "name": "@natalnode/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/executable/server-main.js",
    "notification-worker": "node dist/executable/notification-worker-main.js",
    "migrate": "node dist/executable/migration-main.js",
    "maintenance:auth-cleanup": "node dist/executable/auth-lifecycle-maintenance-main.js",
    "maintenance:community-retention": "node dist/executable/community-retention-maintenance-main.js",
    "maintenance:practitioner-retention": "node dist/executable/practitioner-retention-maintenance-main.js",
    "maintenance:feedback-retention": "node dist/executable/feedback-retention-maintenance-main.js",
    "test:practitioner": "npm run build --workspace=@natalnode/contracts && npm run build && node --test test/practitioner.test.mjs",
    "local": "node dist/executable/local-main.js",
    "public": "node dist/executable/public-development-main.js",
    "check": "tsc --noEmit",
    "test:vault": "npm run build && node --test test/vault.test.mjs",
    "test:feedback": "npm run build && node --test test/feedback.test.mjs",
    "test:public-development": "node --test test/public-development.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@natalnode/contracts": "0.1.0",
    "@natalnode/engine-client": "0.1.0",
    "hono": "^4.13.4",
    "pg": "^8.23.0",
    "resend": "^6.22.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^6.0.3"
  }
}
