{
  "name": "natalnode-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm run build --workspace=packages/contracts --workspace=packages/test-fixtures --workspace=packages/engine-client --workspace=apps/web --workspace=server",
    "build:local": "node scripts/build-local-development.mjs",
    "build:server": "npm run build --workspace=packages/contracts --workspace=packages/test-fixtures --workspace=packages/engine-client --workspace=server",
    "check": "npm run check --workspaces --if-present",
    "test:engineering-integrity": "node --test scripts/test-engineering-integrity.test.mjs",
    "test:production-architecture-boundaries": "node --test scripts/test-production-architecture-boundaries.test.mjs",
    "test:house-angle-semantic-gate": "node --test scripts/test-house-angle-semantic-gate.test.mjs",
    "test:body-sign-composition": "node --test scripts/test-body-sign-composition.test.mjs",
    "test:body-aspect-composition": "node --test scripts/test-body-aspect-body-composition.test.mjs",
    "test:aspect-signal-policy": "node --test scripts/test-aspect-signal-policy.test.mjs",
    "test:personal-aspect-coverage-expansion": "node --test scripts/test-personal-aspect-coverage-expansion.test.mjs",
    "test:composition-signal-policy": "node --test scripts/test-composition-signal-policy.test.mjs",
    "test:personal-chart-coverage-architecture": "node --test scripts/test-personal-chart-coverage-architecture.test.mjs",
    "test:chart-level-convergence-counterevidence": "node --test scripts/test-chart-level-convergence-counterevidence.test.mjs",
    "test:composition-signal-synthesis-poc": "npm run test:composition-signal-synthesis-poc --workspace=apps/web",
    "test:shared-root-relational-synthesis-poc": "npm run test:shared-root-relational-synthesis-poc --workspace=apps/web",
    "test:relational-my-chart-poc": "npm run test:relational-my-chart-poc --workspace=apps/web",
    "preserver:start": "npm run build:server",
    "server:start": "npm run start --workspace=server",
    "predb:migrate": "npm run build:server",
    "db:migrate": "npm run migrate --workspace=server",
    "predev:local": "npm run build:local",
    "dev:local": "npm run local --workspace=server",
    "predev:public": "node scripts/build-public-development.mjs",
    "dev:public": "npm run public --workspace=server"
  }
}
