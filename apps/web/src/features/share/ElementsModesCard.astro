---
import ShareCard from './ShareCard.astro';
import type { ElementsModesCardModel } from './share-card-models';
import { getUiMessage } from '@/lib/ui-catalog';

interface Props {
  model: ElementsModesCardModel;
}

const { model } = Astro.props;
---

<ShareCard model={model}>
  <div slot="content" class="flex min-w-0 flex-col gap-5">
    <section class="rounded-nn-small border border-nn-border-subtle bg-nn-surface-interactive p-4">
      <p class="nn-type-metadata">{getUiMessage(model.locale, 'share.elements.dimension')}</p>
      <h2 class="nn-type-card-title mt-2 break-words">{model.dimensionLabel} · {model.conceptName}</h2>
      <p class="nn-type-body-small mt-3">{model.description}</p>
    </section>

    <section class="border-t border-nn-border-subtle pt-5" aria-labelledby="share-elements-members-title">
      <h2 class="nn-type-label" id="share-elements-members-title">{model.memberSignsLabel}</h2>
      <ul class="mt-3 grid min-w-0 grid-cols-2 gap-2 sm:grid-cols-3">
        {model.memberSigns.map((sign) => (
          <li class="min-w-0 rounded-nn-small border border-nn-border-subtle bg-nn-surface-interactive px-3 py-2">
            <span class="mr-2 text-nn-accent-supporting" aria-hidden="true">{sign.glyph ?? '·'}</span>
            <span class="break-words font-semibold text-nn-text-primary">{sign.name}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</ShareCard>
