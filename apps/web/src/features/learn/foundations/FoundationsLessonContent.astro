  ko: koContentByLessonId,
  'zh-Hant': zhHantContentByLessonId
} as const;

const localeContent = contentByLocale[locale as keyof typeof contentByLocale];
const Content = localeContent?.[lessonId as keyof typeof localeContent];

if (Content === undefined) {
  throw new Error(`Foundations content is unavailable for ${locale}`);
}
---

<div class="content-prose max-w-reading" data-foundations-content-variant={locale}>
  <Content />
</div>

<script>
  const contentVariants = document.querySelectorAll<HTMLElement>('[data-foundations-content-variant]');
  const requestedLocale = new URLSearchParams(window.location.search).get('contentLocale');
  const defaultLocale = contentVariants[0]?.dataset.foundationsContentVariant ?? 'en';
  const visibleLocale = requestedLocale === 'en' ? 'en' : defaultLocale;

  for (const contentVariant of contentVariants) {
    contentVariant.hidden = contentVariant.dataset.foundationsContentVariant !== visibleLocale;
  }
</script>
