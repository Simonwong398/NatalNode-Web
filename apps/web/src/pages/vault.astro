---
import SiteLayout from '@/layouts/SiteLayout.astro';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Vault | NatalNode',
  description: 'Your saved NatalNode charts.',
  canonical: '/vault',
  robots: 'noindex,nofollow'
};
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--workspace pb-20 pt-12 sm:pt-16">
    <header class="max-w-3xl">
      <p class="nn-eyebrow">Vault</p>
      <h1 class="nn-type-page-title mt-3">
        Your saved charts.
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        Your saved chart collection is available here when you are signed in.
      </p>
    </header>

    <section
      class="mt-10 max-w-5xl"
      data-vault-page
      aria-busy="true"
      aria-labelledby="vault-list-title"
    >
      <h2 class="sr-only" id="vault-list-title">Saved charts</h2>
      <p class="nn-async-state" data-vault-loading role="status" aria-live="polite">
        Loading your Vault…
      </p>
      <p class="nn-async-state nn-async-state--error" data-vault-error role="alert" hidden>
        We couldn't load your Vault. Please try again.
      </p>
      <div class="nn-async-state nn-async-state--empty" data-vault-empty hidden>
        <h3 class="nn-type-section-title">Your Vault is empty.</h3>
        <p class="nn-type-body-small mt-2">Saved charts will appear here.</p>
      </div>
      <ul class="mt-6 grid gap-5 sm:grid-cols-2" data-vault-list hidden></ul>
    </section>
  </main>
</SiteLayout>

<script>
  import { initializeVaultPage } from '@/features/vault/vault-charts';

  const root = document.querySelector<HTMLElement>('[data-vault-page]');
  const loading = root?.querySelector<HTMLElement>('[data-vault-loading]');
  const error = root?.querySelector<HTMLElement>('[data-vault-error]');
  const empty = root?.querySelector<HTMLElement>('[data-vault-empty]');
  const list = root?.querySelector<HTMLUListElement>('[data-vault-list]');

  if (root && loading && error && empty && list) {
    initializeVaultPage({
      root,
      loading,
      error,
      empty,
      list
    });
  }
</script>
