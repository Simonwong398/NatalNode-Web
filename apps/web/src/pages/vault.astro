---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getPresentationLocale } from '@/lib/localization';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Vault | NatalNode',
  description: 'Your saved NatalNode charts.',
  canonical: '/vault',
  robots: 'noindex,nofollow'
};
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--workspace pb-20 pt-12 sm:pt-16">
    <header class="max-w-3xl">
      <p class="nn-eyebrow">{t('nav.vault')}</p>
      <h1 class="nn-type-page-title mt-3">
        {t('vault.title')}
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        {t('vault.description')}
      </p>
    </header>

    <form
      class="nn-surface nn-surface--elevated mt-8 max-w-3xl p-5 sm:p-6"
      data-vault-research-snapshot-form
      hidden
      aria-labelledby="research-snapshot-title"
    >
      <h2 class="nn-type-section-title" id="research-snapshot-title">
        Save approved historical research snapshot
      </h2>
      <p class="nn-type-body-small mt-2">
        This local preproduction capture is preserved without recalculation and is not scientifically or production approved.
      </p>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="nn-type-label">
          Record name
          <input class="nn-input mt-2 w-full" name="displayName" maxlength="120" required value="J2000 historical research snapshot" />
        </label>
        <label class="nn-type-label">
          Category
          <select class="nn-input mt-2 w-full" name="category">
            <option value="SELF">Self</option>
            <option value="FAMILY">Family</option>
            <option value="FRIEND">Friend</option>
          </select>
        </label>
      </div>
      <button class="nn-button nn-button--primary mt-5" type="submit">
        Save research snapshot
      </button>
      <p class="nn-async-state mt-3" data-research-snapshot-status role="status" aria-live="polite"></p>
    </form>

    <section
      class="mt-10 max-w-5xl"
      data-vault-page
      aria-busy="true"
      aria-labelledby="vault-list-title"
    >
      <h2 class="sr-only" id="vault-list-title">{t('vault.listTitle')}</h2>
      <p class="nn-type-metadata mt-4" data-vault-capacity hidden></p>
      <p class="nn-async-state" data-vault-loading role="status" aria-live="polite">
        {t('vault.loading')}
      </p>
      <p class="nn-async-state nn-async-state--error" data-vault-error role="alert" hidden>
        {t('vault.loadError')}
      </p>
      <div class="nn-async-state nn-async-state--empty" data-vault-empty hidden>
        <h3 class="nn-type-section-title">{t('vault.emptyTitle')}</h3>
        <p class="nn-type-body-small mt-2">{t('vault.emptyDescription')}</p>
      </div>
      <ul class="mt-6 grid gap-5 sm:grid-cols-2" data-vault-list hidden></ul>
    </section>
  </main>
</SiteLayout>

<script>
  import {
    initializeResearchSnapshotSave,
    initializeVaultPage
  } from '@/features/vault/vault-charts';

  const researchForm = document.querySelector<HTMLFormElement>(
    '[data-vault-research-snapshot-form]'
  );
  if (researchForm) {
    initializeResearchSnapshotSave(researchForm);
  }

  const root = document.querySelector<HTMLElement>('[data-vault-page]');
  const loading = root?.querySelector<HTMLElement>('[data-vault-loading]');
  const error = root?.querySelector<HTMLElement>('[data-vault-error]');
  const empty = root?.querySelector<HTMLElement>('[data-vault-empty]');
  const list = root?.querySelector<HTMLUListElement>('[data-vault-list]');
  const capacity = root?.querySelector<HTMLElement>('[data-vault-capacity]');

  if (root && loading && error && empty && list && capacity) {
    initializeVaultPage({
      root,
      loading,
      error,
      empty,
      list,
      capacity
    });
  }
</script>
