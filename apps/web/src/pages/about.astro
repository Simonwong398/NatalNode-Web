---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getAboutContent } from '@/content/public/about';
import { getLocalizedPath, getPresentationLocale, type SupportedLocale } from '@/lib/localization';
import { getPublicSeoAlternates } from '@/lib/public-seo';
import type { SeoMetadata } from '@/lib/seo';

interface Props {
  readonly locale?: SupportedLocale;
}

const { locale: requestedLocale } = Astro.props as Props;
const locale = getPresentationLocale(
  Astro.url.pathname,
  requestedLocale ?? Astro.locals.locale
);
const content = getAboutContent(locale);
const seo: SeoMetadata = {
  title: `${content.title} | NatalNode`,
  description: content.description,
  canonical: getLocalizedPath(locale, '/about'),
  alternates: getPublicSeoAlternates('/about')
};
const localize = (path: string): string => getLocalizedPath(locale, path);
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container nn-container--editorial pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl">
      <p class="nn-eyebrow">{content.eyebrow}</p>
      <h1 class="nn-type-page-title mt-3">{content.title}</h1>
      <p class="nn-type-body mt-4 max-w-2xl">{content.description}</p>
    </header>

    <div class="mt-12 max-w-4xl space-y-12 sm:mt-16 sm:space-y-16">
      {content.sections.map((section) => (
        <section class="border-t border-natal-border/70 pt-8 sm:pt-10" aria-labelledby={`${section.id}-title`}>
          <p class="nn-eyebrow">{section.eyebrow}</p>
          <h2 class="nn-type-section-title mt-2" id={`${section.id}-title`}>{section.title}</h2>
          <div class="mt-5 space-y-4 nn-type-body">
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets ? (
              <ul class="list-disc space-y-2 pl-5">
                {section.bullets.map((bullet) => <li>{bullet}</li>)}
              </ul>
            ) : null}
            {section.link ? (
              <p>
                <a
                  class="inline-flex font-semibold text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white"
                  href={localize(section.link.href)}
                >
                  {section.link.label}
                </a>
              </p>
            ) : null}
          </div>
        </section>
      ))}
    </div>
  </main>
</SiteLayout>
