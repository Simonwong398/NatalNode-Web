---
import SiteLayout from '@/layouts/SiteLayout.astro';
import {
  getLocalizedPath,
  getPresentationLocale,
  type SupportedLocale
} from '@/lib/localization';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import type { SeoMetadata } from '@/lib/seo';

interface Props {
  readonly locale?: SupportedLocale;
}

const { locale: requestedLocale } = Astro.props as Props;
const locale = getPresentationLocale(
  Astro.url.pathname,
  requestedLocale ?? Astro.locals.locale
);
const localize = (path: string): string => getLocalizedPath(locale, path);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
const seo: SeoMetadata = {
  title: `${t('practitioner.directory')} | NatalNode`,
  description: t('practitioner.description'),
  canonical: '/practitioners',
  robots: 'index,follow'
};
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container nn-container--reading pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl">
      <p class="nn-eyebrow">{t('practitioner.eyebrow')}</p>
      <h1 class="nn-type-page-title mt-3" id="practitioner-directory-title">
        {t('practitioner.title')}
      </h1>
      <p class="nn-type-body mt-5">{t('practitioner.description')}</p>
      <p class="nn-type-body-small mt-4 max-w-2xl">{t('practitioner.directoryDescription')}</p>
      <a class="nn-button nn-button--secondary mt-7" href={localize('/practitioners/apply')}>
        {t('practitioner.application.title')}
      </a>
    </header>

    <section
      class="mt-14 border-t border-natal-border/70 pt-8 sm:mt-16 sm:pt-10"
      data-practitioner-directory-page
      aria-labelledby="practitioner-directory-section-title"
      aria-busy="true"
    >
      <h2 class="nn-type-section-title" id="practitioner-directory-section-title">
        {t('practitioner.directory')}
      </h2>

      <p class="nn-async-state mt-8" data-practitioner-directory-loading role="status" aria-live="polite">
        {t('practitioner.loading')}
      </p>
      <p
        class="nn-async-state nn-async-state--error mt-8"
        data-practitioner-directory-error
        role="alert"
        tabindex="-1"
        hidden
      ></p>
      <p class="nn-async-state nn-async-state--empty mt-8" data-practitioner-directory-empty hidden>
        {t('practitioner.empty')}
      </p>
      <div class="mt-8 grid gap-5" data-practitioner-directory></div>
      <button class="nn-button nn-button--secondary mt-8" type="button" data-practitioner-directory-more hidden>
        {t('practitioner.loadMore')}
      </button>
    </section>
  </main>
</SiteLayout>

<script>
  import { initializePractitionerDirectory } from '@/features/practitioner/practitioner-public';
  import { parseSupportedLocale } from '@/lib/localization';

  const root = document.querySelector<HTMLElement>('[data-practitioner-directory-page]');
  const locale = parseSupportedLocale(document.documentElement.lang) ?? 'en';
  if (root) {
    initializePractitionerDirectory({ root, locale });
  }
</script>
