---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LEARN_CATEGORIES } from '@/lib/content-taxonomy';
import { resolveCanonicalUrl, type SeoMetadata } from '@/lib/seo';

type Props = {
  entry: CollectionEntry<'learn'>;
};

export async function getStaticPaths() {
  const articles = await getCollection('learn', ({ data }) => !data.draft);

  return articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const category = LEARN_CATEGORIES.find((item) => item.key === entry.data.category);
const seo: SeoMetadata = {
  title: `${entry.data.title} | NatalNode`,
  description: entry.data.description,
  canonical: `/learn/${entry.data.slug}`
};
const canonicalUrl = resolveCanonicalUrl(seo.canonical);
const articleStructuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  ...(entry.data.updatedAt ? { dateModified: entry.data.updatedAt.toISOString() } : {})
};
---

<SiteLayout seo={seo} structuredData={articleStructuredData}>
  <main class="nn-container nn-container--editorial pb-20 pt-8 sm:pb-24 sm:pt-12">
    <article class="max-w-reading">
      <header class="border-b border-natal-border/70 pb-10">
        <a class="nn-button nn-button--quiet -ml-3" href="/learn/">← Back to Learn</a>
        <p class="nn-badge mt-8">
          {category?.label ?? entry.data.category}
        </p>
        <h1 class="nn-type-page-title mt-4">
          {entry.data.title}
        </h1>
        <p class="nn-type-body mt-5">{entry.data.description}</p>
        <time class="nn-type-metadata mt-5 block" datetime={entry.data.publishedAt.toISOString()}>
          Published {entry.data.publishedAt.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
        </time>
      </header>

      <div class="content-prose pt-10">
        <Content />
      </div>
    </article>
  </main>
</SiteLayout>
