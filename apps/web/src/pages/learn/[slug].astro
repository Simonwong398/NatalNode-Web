---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LEARN_CATEGORIES } from '@/lib/content-taxonomy';
import type { SeoMetadata } from '@/lib/seo';

type Props = {
  entry: CollectionEntry<'learn'>;
};

export async function getStaticPaths() {
  const articles = await getCollection('learn', ({ data }) => !data.draft);

  return articles.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const category = LEARN_CATEGORIES.find((item) => item.key === entry.data.category);
const seo: SeoMetadata = {
  title: `${entry.data.title} | NatalNode`,
  description: entry.data.description,
  canonical: `/learn/${entry.data.slug}`
};
---

<SiteLayout seo={seo}>
  <main class="mx-auto w-[calc(100%-2rem)] max-w-3xl pb-16 pt-14 sm:pt-20">
    <article>
      <header class="border-b border-natal-border/70 pb-8">
        <a class="text-sm text-natal-accent hover:text-white" href="/learn/">← Back to Learn</a>
        <p class="mt-8 text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">
          {category?.label ?? entry.data.category}
        </p>
        <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-6xl">
          {entry.data.title}
        </h1>
        <p class="mt-5 text-lg leading-8 text-natal-muted">{entry.data.description}</p>
        <time class="mt-5 block text-sm text-slate-400" datetime={entry.data.publishedAt.toISOString()}>
          Published {entry.data.publishedAt.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
        </time>
      </header>

      <div class="content-prose pt-8">
        <Content />
      </div>
    </article>
  </main>
</SiteLayout>
