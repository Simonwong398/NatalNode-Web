---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LEARN_CATEGORIES, type LearnCategory } from '@/lib/content-taxonomy';
import { getLocalizedPath, getPresentationLocale, type SupportedLocale } from '@/lib/localization';
import { getPublicSeoAlternates } from '@/lib/public-seo';
import { resolveCanonicalUrl, type SeoMetadata } from '@/lib/seo';
import { formatUiMessage, getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';

type Props = {
  entry: CollectionEntry<'learn'>;
  locale?: SupportedLocale;
};

export async function getStaticPaths() {
  const articles = await getCollection(
    'learn',
    ({ data }) => !data.draft && data.locale === 'en'
  );

  return articles.map((entry) => ({
    params: { slug: entry.data.contentId },
    props: { entry }
  }));
}

const { entry, locale: requestedLocale } = Astro.props as Props;
const { Content } = await render(entry);
const category = LEARN_CATEGORIES.find((item) => item.key === entry.data.category);
const locale = getPresentationLocale(
  Astro.url.pathname,
  requestedLocale ?? Astro.locals.locale
);
const localize = (path: string): string => getLocalizedPath(locale, path);
const categoryLabelKey: Record<LearnCategory, UiMessageKey> = {
  FOUNDATIONS: 'learn.landing.category.foundations',
  PLANETS: 'learn.landing.category.planets',
  SIGNS: 'learn.landing.category.signs',
  HOUSES: 'learn.landing.category.houses',
  ASPECTS: 'learn.landing.category.aspects',
  CHART_READING: 'learn.landing.category.chartReading'
};
const categoryLabel = category?.key
  ? getUiMessage(locale, categoryLabelKey[category.key])
  : entry.data.category;
const publishedDate = new Intl.DateTimeFormat(locale, {
  dateStyle: 'long',
  timeZone: 'UTC'
}).format(entry.data.publishedAt);
const seo: SeoMetadata = {
  title: `${entry.data.title} | NatalNode`,
  description: entry.data.description,
  canonical: getLocalizedPath(locale, `/learn/${entry.data.contentId}`),
  alternates: getPublicSeoAlternates(`/learn/${entry.data.contentId}`)
};
const canonicalUrl = resolveCanonicalUrl(seo.canonical);
const articleStructuredData: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  ...(entry.data.updatedAt ? { dateModified: entry.data.updatedAt.toISOString() } : {})
};
---

<SiteLayout
  seo={seo}
  structuredData={articleStructuredData}
  ogType="article"
  articlePublishedTime={entry.data.publishedAt.toISOString()}
  articleModifiedTime={entry.data.updatedAt?.toISOString()}
>
  <main class="nn-container nn-container--editorial pb-20 pt-8 sm:pb-24 sm:pt-12">
    <article class="max-w-reading">
      <header class="border-b border-natal-border/70 pb-10">
        <a class="nn-button nn-button--quiet -ml-3" href={localize('/learn/')}>{getUiMessage(locale, 'learn.article.backToLearn')}</a>
        <p class="nn-badge mt-8">
          {categoryLabel}
        </p>
        <h1 class="nn-type-page-title mt-4">
          {entry.data.title}
        </h1>
        <p class="nn-type-body mt-5">{entry.data.description}</p>
        <time class="nn-type-metadata mt-5 block" datetime={entry.data.publishedAt.toISOString()}>
          {formatUiMessage(locale, 'learn.article.published', { date: publishedDate })}
        </time>
      </header>

      <div class="content-prose pt-10">
        <Content />
      </div>
    </article>
  </main>
</SiteLayout>
