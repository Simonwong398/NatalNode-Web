---
import { getCollection } from 'astro:content';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LEARN_CATEGORIES } from '@/lib/content-taxonomy';
import type { SeoMetadata } from '@/lib/seo';

const articles = (await getCollection('learn', ({ data }) => !data.draft)).sort(
  (first, second) => second.data.publishedAt.getTime() - first.data.publishedAt.getTime()
);

const seo: SeoMetadata = {
  title: 'Learn Astrology with Clarity | NatalNode',
  description: 'Foundational astrology education with clear language, explicit inputs, and transparent interpretation.',
  canonical: '/learn/'
};

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    dateStyle: 'long',
    timeZone: 'UTC'
  }).format(date);
}
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl">
      <p class="nn-eyebrow">Learn</p>
      <h1 class="nn-type-page-title mt-3">
        Astrology explained with clarity.
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        Start with the structure of a natal chart, understand the language it uses, and keep calculated facts distinct from interpretation.
      </p>
    </header>

    <section class="mt-12 max-w-5xl" aria-labelledby="learn-categories-title">
      <div class="nn-section-header max-w-2xl">
        <p class="nn-eyebrow">Explore the structure</p>
        <h2 class="nn-type-section-title" id="learn-categories-title">
          Learn categories
        </h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {LEARN_CATEGORIES.map((category) => (
          <li class="nn-surface flex min-w-0 flex-col p-5 sm:p-6">
            <h3 class="nn-type-card-title">{category.label}</h3>
            <p class="nn-type-body-small mt-3">{category.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 max-w-4xl" aria-labelledby="learn-articles-title">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div class="nn-section-header">
          <p class="nn-eyebrow">Editorial guide</p>
          <h2 class="nn-type-section-title" id="learn-articles-title">
            Articles
          </h2>
        </div>
        <p class="nn-type-metadata">{articles.length} published article{articles.length === 1 ? '' : 's'}</p>
      </div>

      {articles.length > 0 ? (
        <ul class="mt-8 grid gap-5">
          {articles.map((article) => (
            <li class="nn-surface p-5 sm:p-6">
              <article>
                <p class="nn-badge">{article.data.category.replace('_', ' ')}</p>
                <h3 class="nn-type-card-title mt-4">
                  <a
                    class="font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
                    href={`/learn/${article.data.slug}`}
                  >
                    {article.data.title}
                  </a>
                </h3>
                <p class="nn-type-body-small mt-3 max-w-3xl">
                  {article.data.summary ?? article.data.description}
                </p>
                <time class="nn-type-metadata mt-5 block" datetime={article.data.publishedAt.toISOString()}>
                  Published {formatDate(article.data.publishedAt)}
                </time>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="nn-async-state nn-async-state--empty mt-8 max-w-3xl">
          Published articles will appear here once they are ready for readers.
        </p>
      )}
    </section>
  </main>
</SiteLayout>
