---
import { getCollection } from 'astro:content';
import EditorialPlanetHero from '@/components/EditorialPlanetHero.astro';
import FoundationsCourseSummary from '@/features/learn/foundations/FoundationsCourseSummary';
import { getFoundationsUiMessages } from '@/features/learn/foundations/ui';
import { getAstrologyGlyph, getAstrologyNotation } from '@/core/astrology-taxonomy/AstrologyGlyph';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { LEARN_CATEGORIES, type LearnCategory } from '@/lib/content-taxonomy';
import {
  getLocalizedPath,
  getPresentationLocale,
  type SupportedLocale
} from '@/lib/localization';
import { createPublicSeo } from '@/lib/public-seo';
import type { SeoMetadata } from '@/lib/seo';
import { formatUiMessage, getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import {
  getEducationalChart,
  getEducationalChartPresentationPolicy
} from '@/features/learn/educational-chart-source';

interface Props {
  readonly locale?: SupportedLocale;
}

const { locale: requestedLocale } = Astro.props as Props;

const locale = getPresentationLocale(
  Astro.url.pathname,
  requestedLocale ?? Astro.locals.locale
);
const articles = (await getCollection('learn', ({ data }) =>
  !data.draft && data.locale === locale
)).sort(
  (first, second) => second.data.publishedAt.getTime() - first.data.publishedAt.getTime()
);

const educationalChart = await getEducationalChart();
const educationalChartPresentationPolicy = getEducationalChartPresentationPolicy();
const localize = (path: string): string => getLocalizedPath(locale, path);
const foundationsUi = getFoundationsUiMessages(locale);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
const seo: SeoMetadata = createPublicSeo(
  locale,
  '/learn/',
  `${t('learn.landing.title')} | NatalNode`,
  t('learn.landing.description')
);

const categoryCopy: Record<LearnCategory, { label: UiMessageKey; description: UiMessageKey }> = {
  FOUNDATIONS: {
    label: 'learn.landing.category.foundations',
    description: 'learn.landing.category.foundationsDescription'
  },
  PLANETS: {
    label: 'learn.landing.category.planets',
    description: 'learn.landing.category.planetsDescription'
  },
  SIGNS: {
    label: 'learn.landing.category.signs',
    description: 'learn.landing.category.signsDescription'
  },
  HOUSES: {
    label: 'learn.landing.category.houses',
    description: 'learn.landing.category.housesDescription'
  },
  ASPECTS: {
    label: 'learn.landing.category.aspects',
    description: 'learn.landing.category.aspectsDescription'
  },
  CHART_READING: {
    label: 'learn.landing.category.chartReading',
    description: 'learn.landing.category.chartReadingDescription'
  }
};

function categoryNotation(category: LearnCategory): string | undefined {
  switch (category) {
    case 'PLANETS':
      return getAstrologyGlyph('body', 'Saturn');
    case 'SIGNS':
      return getAstrologyGlyph('sign', 'Aries');
    case 'HOUSES':
      return getAstrologyNotation('house', 1, 'romanNumeral');
    case 'ASPECTS':
      return getAstrologyGlyph('aspect', 'trine');
    default:
      return undefined;
  }
}

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat(locale, {
    dateStyle: 'long',
    timeZone: 'UTC'
  }).format(date);
}
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial pb-20 pt-12 sm:pb-24 sm:pt-16">
    <EditorialPlanetHero
      eyebrow={t('learn.landing.eyebrow')}
      title={t('learn.landing.title')}
      description={t('learn.landing.description')}
      titleId="learn-hero-title"
      chart={educationalChart}
      locale={locale}
      presentationPolicy={educationalChartPresentationPolicy}
    />

    <FoundationsCourseSummary client:load locale={locale} ui={foundationsUi} />

    <section class="mt-12 max-w-4xl border-t border-natal-border/70 pt-8 sm:mt-16 sm:pt-10" aria-labelledby="learn-articles-title">
      <div class="nn-section-header">
        <p class="nn-eyebrow">{t('learn.landing.startHere')}</p>
        <h2 class="nn-type-section-title" id="learn-articles-title">
          {t('learn.landing.beginFoundations')}
        </h2>
      </div>

      {articles.length > 0 ? (
        <ul class="mt-8 grid gap-5">
          {articles.map((article) => (
            <li class="nn-surface p-5 sm:p-6">
              <article>
                <p class="nn-badge">
                  {categoryCopy[article.data.category]
                    ? t(categoryCopy[article.data.category].label)
                    : article.data.category.replace('_', ' ')}
                </p>
                <h3 class="nn-type-card-title mt-4">
                  <a
                    class="font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
                    href={localize(`/learn/${article.data.contentId}`)}
                  >
                    {article.data.title}
                  </a>
                </h3>
                <p class="nn-type-body-small mt-3 max-w-3xl">
                  {article.data.summary ?? article.data.description}
                </p>
                <a
                  class="mt-5 inline-flex font-semibold text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white"
                  href={localize(`/learn/${article.data.contentId}`)}
                >
                  {t('learn.landing.readGuide')}
                </a>
                <time class="nn-type-metadata mt-5 block" datetime={article.data.publishedAt.toISOString()}>
                  {formatUiMessage(locale, 'learn.landing.published', {
                    date: formatDate(article.data.publishedAt)
                  })}
                </time>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="nn-async-state nn-async-state--empty mt-8 max-w-3xl">
          {t('learn.landing.empty')}
        </p>
      )}
    </section>

    <section class="mt-12 max-w-4xl border-t border-natal-border/70 pt-8 sm:mt-16 sm:pt-10" aria-labelledby="learn-methodology-title">
      <p class="nn-eyebrow">{t('learn.landing.howItWorks')}</p>
      <h2 class="nn-type-section-title mt-2" id="learn-methodology-title">
        {t('learn.landing.methodTitle')}
      </h2>
      <p class="nn-type-body-small mt-3 max-w-2xl">
        {t('learn.landing.methodDescription')}
      </p>
      <a
        class="mt-5 inline-flex font-semibold text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white"
        href={localize('/methodology')}
      >
        {t('learn.landing.methodology')}
      </a>
    </section>

    <section class="mt-12 max-w-5xl" id="learn-categories" aria-labelledby="learn-categories-title">
      <div class="nn-section-header max-w-2xl">
        <p class="nn-eyebrow">{t('learn.landing.exploreStructure')}</p>
        <h2 class="nn-type-section-title" id="learn-categories-title">
          {t('learn.landing.categoriesTitle')}
        </h2>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {LEARN_CATEGORIES.map((category) => (
          <li class="nn-surface flex min-w-0 flex-col p-5 sm:p-6">
            <h3 class="nn-type-card-title">
              {categoryNotation(category.key) ? (
                <span aria-hidden="true" class="nn-astrology-glyph mr-2 text-natal-accent">
                  {categoryNotation(category.key)}
                </span>
              ) : null}
              {t(categoryCopy[category.key].label)}
            </h3>
            <p class="nn-type-body-small mt-3">{t(categoryCopy[category.key].description)}</p>
          </li>
        ))}
      </ul>
    </section>
  </main>
</SiteLayout>
