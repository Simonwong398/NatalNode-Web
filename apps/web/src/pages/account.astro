---
import SiteLayout from '@/layouts/SiteLayout.astro';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Account | NatalNode',
  description: 'Manage your NatalNode account.',
  canonical: '/account',
  robots: 'noindex,nofollow'
};
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container nn-container--form py-12 sm:py-16">
    <header class="max-w-2xl">
      <p class="nn-eyebrow">Account</p>
      <h1 class="nn-type-page-title mt-3" id="account-page-title">
        Account management
      </h1>
      <p class="nn-type-body mt-4">
        Manage the lifecycle of your NatalNode account.
      </p>
    </header>

    <section
      class="mt-10"
      data-account-page
      aria-labelledby="account-page-title"
      aria-busy="true"
    >
      <p class="nn-async-state" data-account-loading role="status" aria-live="polite">
        Confirming your session…
      </p>

      <p
        class="nn-async-state nn-async-state--error"
        data-account-session-error
        role="alert"
        tabindex="-1"
        hidden
      >
        We couldn't confirm your session. Refresh the page and try again.
      </p>

      <div class="max-w-2xl" data-account-content hidden>
        <section
          class="nn-surface nn-surface--elevated p-6 sm:p-8"
          data-account-notifications
          aria-labelledby="account-notifications-title"
          aria-busy="true"
        >
          <p class="nn-eyebrow">Notifications</p>
          <h2 class="nn-type-section-title mt-3" id="account-notifications-title">
            Browser notifications
          </h2>
          <p class="nn-type-body-small mt-3 max-w-xl" id="account-notifications-description">
            Get notifications from NatalNode on this browser.
          </p>
          <p class="nn-type-metadata mt-3 max-w-xl" id="account-notifications-privacy">
            Browser notifications may appear on your lock screen or on a shared device.
            Review the notification preview settings on your device before enabling them.
          </p>

          <p class="nn-async-state mt-6" data-notifications-loading role="status" aria-live="polite">
            Loading notification settings…
          </p>

          <div data-notifications-content hidden>
            <div class="mt-6 border-t border-[var(--nn-border-subtle)] pt-6">
              <p class="nn-type-label">This browser</p>
              <p
                class="nn-type-body-small mt-2"
                data-notifications-permission
                id="account-notifications-permission"
              ></p>
              <p
                class="nn-type-body-small mt-2"
                data-notifications-connection
                id="account-notifications-connection"
              ></p>

              <div class="mt-5 flex flex-wrap gap-3">
                <button
                  class="nn-button nn-button--primary"
                  data-notifications-enable
                  type="button"
                  aria-describedby="account-notifications-description account-notifications-permission account-notifications-error"
                >
                  Enable on this browser
                </button>
                <button
                  class="nn-button nn-button--secondary"
                  data-notifications-disable
                  type="button"
                  aria-describedby="account-notifications-connection account-notifications-error"
                  hidden
                >
                  Disable on this browser
                </button>
              </div>
            </div>

            <fieldset class="mt-8 border-t border-[var(--nn-border-subtle)] pt-6" data-notifications-categories>
              <legend class="nn-type-label">Notification categories</legend>
              <p class="nn-type-body-small mt-2" id="account-notifications-category-help">
                Choose which account-owned categories may use browser notifications when available.
                Categories do not create a browser subscription.
              </p>

              <div class="mt-5 grid gap-4">
                <label class="flex min-w-0 items-start gap-3" for="account-notifications-category-account">
                  <input
                    class="nn-checkbox mt-1 shrink-0"
                    id="account-notifications-category-account"
                    data-notifications-category="ACCOUNT"
                    type="checkbox"
                    aria-describedby="account-notifications-category-account-state account-notifications-category-account-help account-notifications-category-help"
                  />
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="nn-type-label">Account</span>
                      <span
                        class="nn-type-metadata"
                        data-notifications-category-state="ACCOUNT"
                        id="account-notifications-category-account-state"
                      >Not set</span>
                    </span>
                    <span class="nn-type-body-small mt-1 block" id="account-notifications-category-account-help">
                      Account and product updates when available.
                    </span>
                  </span>
                </label>

                <label class="flex min-w-0 items-start gap-3" for="account-notifications-category-system">
                  <input
                    class="nn-checkbox mt-1 shrink-0"
                    id="account-notifications-category-system"
                    data-notifications-category="SYSTEM"
                    type="checkbox"
                    aria-describedby="account-notifications-category-system-state account-notifications-category-system-help account-notifications-category-help"
                  />
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="nn-type-label">System</span>
                      <span
                        class="nn-type-metadata"
                        data-notifications-category-state="SYSTEM"
                        id="account-notifications-category-system-state"
                      >Not set</span>
                    </span>
                    <span class="nn-type-body-small mt-1 block" id="account-notifications-category-system-help">
                      Important NatalNode system updates when available.
                    </span>
                  </span>
                </label>

                <label class="flex min-w-0 items-start gap-3" for="account-notifications-category-astrology-alert">
                  <input
                    class="nn-checkbox mt-1 shrink-0"
                    id="account-notifications-category-astrology-alert"
                    data-notifications-category="ASTROLOGY_ALERT"
                    type="checkbox"
                    aria-describedby="account-notifications-category-astrology-alert-state account-notifications-category-astrology-alert-help account-notifications-category-help"
                  />
                  <span class="min-w-0">
                    <span class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                      <span class="nn-type-label">Astrology alerts</span>
                      <span
                        class="nn-type-metadata"
                        data-notifications-category-state="ASTROLOGY_ALERT"
                        id="account-notifications-category-astrology-alert-state"
                      >Not set</span>
                    </span>
                    <span class="nn-type-body-small mt-1 block" id="account-notifications-category-astrology-alert-help">
                      Future astrology alerts when available.
                    </span>
                  </span>
                </label>
              </div>
            </fieldset>

            <p
              class="nn-status mt-5"
              data-notifications-status
              id="account-notifications-status"
              role="status"
              aria-live="polite"
              hidden
            ></p>
            <p
              class="nn-notice nn-notice--error mt-5"
              data-notifications-error
              id="account-notifications-error"
              role="alert"
              tabindex="-1"
              hidden
            ></p>
          </div>
        </section>

        <section
          class="nn-surface nn-surface--elevated mt-8 p-6 sm:p-8"
          data-account-export
          aria-labelledby="account-export-title"
        >
          <p class="nn-eyebrow">Your data</p>
          <h2 class="nn-type-section-title mt-3" id="account-export-title">
            Download your data
          </h2>
          <p class="nn-type-body-small mt-3 max-w-xl" id="account-export-description">
            Download a JSON copy of your NatalNode account data, including saved chart data
            and account-owned content. Downloading does not change or delete your account,
            and export is optional. You do not need to download your data before deleting
            your account.
          </p>

          <form
            class="mt-6"
            data-account-export-form
            method="post"
            action="/api/account/export"
            target="account-export-response"
            aria-busy="false"
          >
            <button
              class="nn-button nn-button--primary"
              data-account-export-submit
              type="submit"
              aria-describedby="account-export-description account-export-status"
            >
              Download your data
            </button>
            <p
              class="nn-status mt-4"
              data-account-export-status
              id="account-export-status"
              role="status"
              aria-live="polite"
              hidden
            ></p>
            <p
              class="nn-notice nn-notice--error mt-4"
              data-account-export-error
              id="account-export-error"
              role="alert"
              tabindex="-1"
              hidden
            ></p>
            <section
              class="nn-notice nn-notice--error mt-4 flex-col"
              data-account-export-reauth
              role="alert"
              aria-labelledby="account-export-reauth-title"
              tabindex="-1"
              hidden
            >
              <h3 class="font-semibold text-[var(--nn-text-primary)]" id="account-export-reauth-title">
                Re-authentication required
              </h3>
              <p>
                For security, sign in again before downloading your account data.
              </p>
              <a class="nn-button nn-button--secondary self-start" href="/auth/sign-in">
                Sign in again
              </a>
            </section>
          </form>
        </section>

        <section
          class="account-danger-surface mt-8 p-6 sm:p-8"
          aria-labelledby="account-danger-title"
        >
          <p class="nn-eyebrow">Danger zone</p>
          <h2 class="nn-type-section-title mt-3" id="account-danger-title">
            Delete account
          </h2>
          <p class="nn-type-body-small mt-3 max-w-xl">
            This permanently removes your account from the active NatalNode application,
            including saved Vault charts and notes and private Feedback associated with
            your account. This is different from deleting one saved chart. You will be
            signed out.
          </p>
          <button
            class="nn-button nn-button--secondary mt-6"
            data-account-delete-open
            type="button"
            aria-expanded="false"
            aria-controls="account-delete-confirmation"
          >
            Delete account
          </button>

          <section
            class="mt-6 border-t border-[var(--nn-border-default)] pt-6"
            id="account-delete-confirmation"
            data-account-delete-confirmation
            aria-labelledby="account-delete-confirmation-title"
            hidden
          >
            <h3
              class="nn-type-card-title"
              id="account-delete-confirmation-title"
              data-account-delete-heading
            >
              Confirm account deletion
            </h3>
            <p class="nn-type-body-small mt-3 max-w-xl" id="account-delete-help">
              Enter <strong>DELETE</strong> exactly to confirm this permanent action.
              A recent sign-in may be required.
            </p>

            <form class="mt-5" data-account-delete-form novalidate aria-busy="false">
              <label class="nn-type-label" for="account-delete-phrase">
                Confirmation phrase
              </label>
              <input
                class="nn-field mt-2 max-w-sm"
                id="account-delete-phrase"
                data-account-delete-input
                name="confirmation"
                type="text"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                aria-describedby="account-delete-help account-delete-error"
              />

              <div class="mt-5 flex flex-wrap gap-3">
                <button
                  class="nn-button nn-button--secondary"
                  data-account-delete-cancel
                  type="button"
                >
                  Cancel
                </button>
                <button
                  class="nn-button account-danger-button"
                  data-account-delete-submit
                  type="submit"
                  disabled
                >
                  Delete account permanently
                </button>
              </div>

              <p
                class="nn-status mt-4"
                data-account-delete-pending
                role="status"
                aria-live="polite"
                hidden
              >
                Deleting your account…
              </p>
              <p
                class="nn-notice nn-notice--error mt-4"
                id="account-delete-error"
                data-account-delete-error
                role="alert"
                tabindex="-1"
                hidden
              ></p>
              <section
                class="nn-notice nn-notice--error mt-4 flex-col"
                data-account-reauth
                role="alert"
                aria-labelledby="account-reauth-title"
                tabindex="-1"
                hidden
              >
                <h4 class="font-semibold text-[var(--nn-text-primary)]" id="account-reauth-title">
                  Re-authentication required
                </h4>
                <p>
                  For security, please sign in again with an Email Magic Link before
                  deleting your account.
                </p>
                <a class="nn-button nn-button--secondary self-start" href="/auth/sign-in">
                  Sign in again
                </a>
              </section>
            </form>
          </section>
        </section>
      </div>

      <iframe
        name="account-export-response"
        data-account-export-response
        title=""
        aria-hidden="true"
        tabindex="-1"
        hidden
      ></iframe>
    </section>
  </main>
</SiteLayout>

<script>
  import type { NotificationCategory } from '@natalnode/contracts';
  import { initializeAccountExport } from '@/features/account/account-export';
  import { initializeAccountDeletion } from '@/features/account/account-deletion';
  import { initializeNotificationSettings } from '@/features/notifications/notification-settings';

  const root = document.querySelector<HTMLElement>('[data-account-page]');
  const loading = root?.querySelector<HTMLElement>('[data-account-loading]');
  const sessionError = root?.querySelector<HTMLElement>('[data-account-session-error]');
  const accountContent = root?.querySelector<HTMLElement>('[data-account-content]');
  const openButton = root?.querySelector<HTMLButtonElement>('[data-account-delete-open]');
  const confirmationRegion = root?.querySelector<HTMLElement>('[data-account-delete-confirmation]');
  const form = root?.querySelector<HTMLFormElement>('[data-account-delete-form]');
  const confirmationInput = root?.querySelector<HTMLInputElement>('[data-account-delete-input]');
  const cancelButton = root?.querySelector<HTMLButtonElement>('[data-account-delete-cancel]');
  const submitButton = root?.querySelector<HTMLButtonElement>('[data-account-delete-submit]');
  const pendingStatus = root?.querySelector<HTMLElement>('[data-account-delete-pending]');
  const errorStatus = root?.querySelector<HTMLElement>('[data-account-delete-error]');
  const reauthStatus = root?.querySelector<HTMLElement>('[data-account-reauth]');
  const exportForm = root?.querySelector<HTMLFormElement>('[data-account-export-form]');
  const exportSubmitButton = root?.querySelector<HTMLButtonElement>('[data-account-export-submit]');
  const exportStatus = root?.querySelector<HTMLElement>('[data-account-export-status]');
  const exportError = root?.querySelector<HTMLElement>('[data-account-export-error]');
  const exportReauthStatus = root?.querySelector<HTMLElement>('[data-account-export-reauth]');
  const exportResponseFrame = root?.querySelector<HTMLIFrameElement>('[data-account-export-response]');
  const notificationsRoot = root?.querySelector<HTMLElement>('[data-account-notifications]');
  const notificationsLoading = notificationsRoot?.querySelector<HTMLElement>('[data-notifications-loading]');
  const notificationsContent = notificationsRoot?.querySelector<HTMLElement>('[data-notifications-content]');
  const notificationsPermission = notificationsRoot?.querySelector<HTMLElement>('[data-notifications-permission]');
  const notificationsConnection = notificationsRoot?.querySelector<HTMLElement>('[data-notifications-connection]');
  const notificationsEnable = notificationsRoot?.querySelector<HTMLButtonElement>('[data-notifications-enable]');
  const notificationsDisable = notificationsRoot?.querySelector<HTMLButtonElement>('[data-notifications-disable]');
  const notificationsStatus = notificationsRoot?.querySelector<HTMLElement>('[data-notifications-status]');
  const notificationsError = notificationsRoot?.querySelector<HTMLElement>('[data-notifications-error]');
  const notificationCategoryControls = Array.from(
    notificationsRoot?.querySelectorAll<HTMLInputElement>('[data-notifications-category]') ?? []
  ).flatMap((input) => {
    const category = input.dataset.notificationsCategory;
    const categoryState = category === undefined
      ? null
      : notificationsRoot?.querySelector<HTMLElement>(
          `[data-notifications-category-state="${category}"]`
        );

    if (
      (category !== 'ACCOUNT' && category !== 'SYSTEM' && category !== 'ASTROLOGY_ALERT') ||
      categoryState === null ||
      categoryState === undefined
    ) {
      return [];
    }

    return [{ category: category as NotificationCategory, input, state: categoryState }];
  });

  if (
    root && loading && sessionError && accountContent && openButton &&
    confirmationRegion && form && confirmationInput && cancelButton &&
    submitButton && pendingStatus && errorStatus && reauthStatus
  ) {
    initializeAccountDeletion({
      root,
      loading,
      sessionError,
      accountContent,
      openButton,
      confirmationRegion,
      form,
      confirmationInput,
      cancelButton,
      submitButton,
      pendingStatus,
      errorStatus,
      reauthStatus
    });
  }

  if (
    accountContent && exportForm && exportSubmitButton && exportStatus &&
    exportError && exportReauthStatus && exportResponseFrame
  ) {
    initializeAccountExport({
      accountContent,
      form: exportForm,
      submitButton: exportSubmitButton,
      statusElement: exportStatus,
      errorStatus: exportError,
      reauthStatus: exportReauthStatus,
      responseFrame: exportResponseFrame
    });
  }

  if (
    notificationsRoot && notificationsLoading && notificationsContent &&
    notificationsPermission && notificationsConnection && notificationsEnable &&
    notificationsDisable && notificationsStatus && notificationsError
  ) {
    initializeNotificationSettings({
      root: notificationsRoot,
      loading: notificationsLoading,
      content: notificationsContent,
      permissionStatus: notificationsPermission,
      connectionStatus: notificationsConnection,
      enableButton: notificationsEnable,
      disableButton: notificationsDisable,
      status: notificationsStatus,
      error: notificationsError,
      categoryControls: notificationCategoryControls
    });
  }
</script>

<style>
  [data-account-notifications] .nn-button--unavailable,
  [data-account-notifications] .nn-button--unavailable:hover {
    color: var(--nn-text-muted);
    border-color: var(--nn-border-subtle);
    border-style: dashed;
    background: var(--nn-surface-base);
    box-shadow: none;
  }

  .account-danger-surface {
    border: 1px solid color-mix(in srgb, var(--nn-status-error) 38%, var(--nn-border-default));
    border-radius: var(--nn-radius-medium);
    background: color-mix(in srgb, var(--nn-status-error-surface) 54%, var(--nn-surface-base));
  }

  .account-danger-button {
    color: var(--nn-text-primary);
    border-color: color-mix(in srgb, var(--nn-status-error) 72%, var(--nn-border-default));
    background: color-mix(in srgb, var(--nn-status-error) 32%, var(--nn-surface-interactive));
  }

  .account-danger-button:hover:not(:disabled) {
    border-color: var(--nn-status-error);
    background: color-mix(in srgb, var(--nn-status-error) 44%, var(--nn-surface-interactive));
  }
</style>
