---
import SiteLayout from '@/layouts/SiteLayout.astro';
import WeeklyReadingPrototypeR2 from '@/features/interpretation/WeeklyReadingPrototypeR2';
import { createWeeklyReadingR2Scenarios } from '@/features/interpretation/weekly-reading-prototype-r2';
import type { SeoMetadata } from '@/lib/seo';
import '@/styles/weekly-reading-r2.css';

const isWeeklyR2Available =
  import.meta.env.DEV || process.env.NATALNODE_LOCAL_DEV_PREVIEW === 'true';
const scenarios = createWeeklyReadingR2Scenarios();

const seo: SeoMetadata = {
  title: 'Weekly Sky Portrait R2 Prototype | NatalNode',
  description: 'Development-only preview for the Weekly Sky Portrait R2 visual prototype.',
  canonical: '/dev/weekly-reading-r2',
  robots: 'noindex,nofollow'
};
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container max-w-[78rem] pb-16 pt-8 sm:pb-24 sm:pt-12">
    {isWeeklyR2Available ? (
      <WeeklyReadingPrototypeR2 scenarios={scenarios} client:load />
    ) : (
      <section class="mx-auto max-w-2xl" aria-labelledby="weekly-r2-unavailable-title">
        <p class="nn-eyebrow">Development only</p>
        <h1 class="nn-type-page-title mt-3" id="weekly-r2-unavailable-title">Weekly Sky Portrait R2 prototype</h1>
        <p class="nn-type-body mt-4">This development preview is unavailable in production builds.</p>
      </section>
    )}
  </main>
</SiteLayout>
