---
import SiteLayout from '@/layouts/SiteLayout.astro';
import LocalEngineChartWorkflow from '@/features/chart-experience/LocalEngineChartWorkflow';
import { getPresentationLocale } from '@/lib/localization';
import type { SupportedLocale } from '@/lib/localization';
import type { SeoMetadata } from '@/lib/seo';

interface Props {
  readonly locale?: SupportedLocale;
}

const locale = Astro.props.locale ??
  getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const isLocalEngineWorkflowAvailable =
  import.meta.env.DEV && process.env.NATALNODE_LOCAL_CHART_WORKFLOW === 'true';

const seo: SeoMetadata = {
  title: 'Chart Experience Preview | NatalNode',
  description: 'Development-only preview for the bounded chart experience.',
  canonical: '/dev/chart',
  robots: 'noindex,nofollow'
};
---

<SiteLayout seo={seo} mode="observatory">
  <main class="nn-container nn-container--calculate nn-calculate-page min-h-screen pb-12 pt-10 sm:pt-14">
    {isLocalEngineWorkflowAvailable ? (
      <LocalEngineChartWorkflow locale={locale} client:load />
    ) : import.meta.env.DEV ? (
      <section class="nn-surface p-5 sm:p-7" aria-labelledby="chart-preview-unavailable-title">
        <p class="nn-eyebrow">Local development only</p>
        <h1 class="nn-type-page-title mt-3" id="chart-preview-unavailable-title">Chart workflow</h1>
        <p class="nn-type-body mt-4">Start <code>npm run dev:chart-workflow</code> to use canonical location search, server-owned civil-time verification, and the isolated private Engine calculation.</p>
      </section>
    ) : (
      <section class="nn-surface p-5 sm:p-7" aria-labelledby="chart-preview-unavailable-title">
        <p class="nn-eyebrow">Development only</p>
        <h1 class="nn-type-page-title mt-3" id="chart-preview-unavailable-title">Chart workflow</h1>
        <p class="nn-type-body mt-4">This development workflow is unavailable in production builds.</p>
      </section>
    )}
  </main>
</SiteLayout>
