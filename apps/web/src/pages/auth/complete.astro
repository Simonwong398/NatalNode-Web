---
import Surface from '@/components/ui/Surface.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getPresentationLocale } from '@/lib/localization';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';

const seo = {
  title: 'Completing sign-in | NatalNode',
  description: 'Completing your NatalNode sign-in.',
  canonical: '/auth/complete',
  robots: 'noindex,nofollow'
} as const;
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container nn-container--form flex min-h-screen items-center justify-center py-16 sm:py-20">
    <Surface variant="elevated" class="w-full max-w-xl">
      <section class="nn-section-header p-8 text-center sm:p-10" aria-labelledby="auth-completion-title">
        <p class="nn-eyebrow">NatalNode</p>
        <h1 class="nn-type-page-title" id="auth-completion-title">
          {t('auth.signIn')}
        </h1>
        <p class="nn-async-state mt-2" id="auth-completion-status" aria-live="polite">
          {t('auth.signingIn')}
        </p>
      </section>
    </Surface>
  </main>

  <script>
    import { completeEmailMagicLink } from '@/features/auth/complete-email-magic-link';

    const statusElement = document.querySelector<HTMLElement>('#auth-completion-status');

    if (statusElement) {
      void completeEmailMagicLink(statusElement);
    }
  </script>
</SiteLayout>
