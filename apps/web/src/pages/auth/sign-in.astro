---
import Surface from '@/components/ui/Surface.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';

const seo = {
  title: 'Sign in | NatalNode',
  description: 'Sign in to NatalNode with your email.',
  canonical: '/auth/sign-in',
  robots: 'noindex,nofollow'
} as const;
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container nn-container--form flex min-h-screen items-center justify-center py-16 sm:py-20">
    <Surface variant="elevated" class="w-full max-w-xl">
      <section class="p-8 sm:p-10" aria-labelledby="sign-in-title">
        <header class="nn-section-header">
          <p class="nn-eyebrow">NatalNode</p>
          <h1 class="nn-type-page-title" id="sign-in-title">
            Sign in
          </h1>
          <p class="nn-type-body-small" id="sign-in-description">
            Enter your email and we'll send you a secure sign-in link.
          </p>
        </header>

        <form class="mt-10" id="email-sign-in-form">
          <label class="nn-type-label" for="sign-in-email">
            Email address
          </label>
          <input
            class="nn-field mt-2"
            id="sign-in-email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            aria-describedby="sign-in-description sign-in-email-help sign-in-status"
          />
          <p class="nn-type-body-small mt-2" id="sign-in-email-help">
            We'll use this address to start sign-in.
          </p>
          <button
            class="nn-button nn-button--primary mt-6 w-full"
            id="sign-in-submit"
            type="submit"
          >
            Send sign-in link
          </button>
          <p
            class="nn-status nn-status--error mt-4 min-h-6"
            id="sign-in-status"
            aria-live="polite"
          ></p>
        </form>

        <p
          class="nn-status nn-status--error mt-8"
          id="google-sign-in-status"
          aria-live="polite"
          hidden
        ></p>

        <div
          class="mt-8"
          id="google-sign-in-option"
          aria-hidden="true"
          hidden
        >
          <div class="flex items-center gap-3" aria-hidden="true">
            <span class="h-px flex-1 bg-natal-border/70"></span>
            <span class="nn-type-body-small px-1 text-natal-muted">or</span>
            <span class="h-px flex-1 bg-natal-border/70"></span>
          </div>
          <form
            class="mt-6"
            id="google-sign-in-form"
            method="post"
            action="/api/auth/google/start"
          >
            <button
              class="nn-button nn-button--secondary w-full"
              type="submit"
            >
              Continue with Google
            </button>
          </form>
        </div>

        <section
          class="nn-notice nn-notice--info mt-10 flex-col"
          id="sign-in-success"
          aria-labelledby="sign-in-success-title"
          tabindex="-1"
          hidden
        >
          <h2 class="nn-type-section-title" id="sign-in-success-title">
            Check your email
          </h2>
          <p class="nn-type-body-small">
            Use the sign-in link in the email to continue.
          </p>
        </section>
      </section>
    </Surface>
  </main>

  <script>
    import { setupEmailMagicLinkRequest } from '@/features/auth/request-email-magic-link';
    import { initializeGoogleSignIn } from '@/features/auth/google-sign-in';

    const form = document.querySelector<HTMLFormElement>('#email-sign-in-form');
    const emailInput = document.querySelector<HTMLInputElement>('#sign-in-email');
    const submitButton = document.querySelector<HTMLButtonElement>('#sign-in-submit');
    const statusElement = document.querySelector<HTMLElement>('#sign-in-status');
    const successElement = document.querySelector<HTMLElement>('#sign-in-success');
    const googleOption = document.querySelector<HTMLElement>('#google-sign-in-option');
    const googleFailureStatus = document.querySelector<HTMLElement>('#google-sign-in-status');

    if (form && googleOption && googleFailureStatus) {
      initializeGoogleSignIn({
        emailForm: form,
        option: googleOption,
        failureStatus: googleFailureStatus
      });
    }

    if (form && emailInput && submitButton && statusElement && successElement) {
      setupEmailMagicLinkRequest({
        form,
        emailInput,
        submitButton,
        statusElement,
        successElement
      });
    }
  </script>
</SiteLayout>
