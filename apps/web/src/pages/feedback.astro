---
import Surface from '@/components/ui/Surface.astro';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getPresentationLocale } from '@/lib/localization';
import { formatUiMessage, getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Feedback | NatalNode',
  description: 'Send private product feedback to NatalNode.',
  canonical: '/feedback',
  robots: 'noindex,nofollow'
};
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
---

<SiteLayout seo={seo} mode="editorial">
  <main class="nn-container nn-container--form py-12 sm:py-16">
    <header class="max-w-2xl">
      <p class="nn-eyebrow">{t('feedback.privateSupport')}</p>
      <h1 class="nn-type-page-title mt-3" id="feedback-page-title">{t('auth.feedback')}</h1>
      <p class="nn-type-body mt-4">
        {t('feedback.description')}
      </p>
    </header>

    <section
      class="mt-10"
      data-feedback-page
      aria-labelledby="feedback-page-title"
      aria-busy="true"
    >
      <p class="nn-async-state" data-feedback-loading role="status" aria-live="polite">
        {t('feedback.confirmingSession')}
      </p>

      <p
        class="nn-async-state nn-async-state--error"
        data-feedback-session-error
        role="alert"
        tabindex="-1"
        hidden
      ></p>

      <div data-feedback-form-container hidden>
        <Surface variant="elevated" class="w-full">
          <form class="p-6 sm:p-8" data-feedback-form novalidate aria-busy="false">
            <div>
            <label class="nn-type-label" for="feedback-category">{t('feedback.category')}</label>
              <select
                class="nn-field mt-2"
                id="feedback-category"
                name="category"
                required
                aria-describedby="feedback-category-error"
              >
                <option value="">{t('feedback.chooseCategory')}</option>
                <option value="BUG">{t('feedback.category.bug')}</option>
                <option value="SUGGESTION">{t('feedback.category.suggestion')}</option>
                <option value="CALCULATION_CONCERN">
                  {t('feedback.category.calculationConcern')}
                </option>
                <option value="OTHER">{t('feedback.category.other')}</option>
              </select>
              <p
                class="nn-status nn-status--error mt-2"
                id="feedback-category-error"
                data-feedback-category-error
                hidden
              ></p>
            </div>

            <div class="mt-6">
              <label class="nn-type-label" for="feedback-message">{t('feedback.message')}</label>
              <textarea
                class="nn-field mt-2 min-h-56 resize-y"
                id="feedback-message"
                name="message"
                rows="9"
                required
                aria-describedby="feedback-message-help feedback-message-count feedback-message-error"
              ></textarea>
              <div class="mt-2 flex flex-wrap justify-between gap-2">
                <p class="nn-type-body-small" id="feedback-message-help">
                  {t('feedback.messageHelp')}
                </p>
                <p
                  class="nn-type-metadata"
                  id="feedback-message-count"
                  data-feedback-message-count
                >
                  {formatUiMessage(locale, 'feedback.characterCount', { count: 0 })}
                </p>
              </div>
              <p
                class="nn-status nn-status--error mt-2"
                id="feedback-message-error"
                data-feedback-message-error
                hidden
              ></p>
            </div>

            <button
              class="nn-button nn-button--primary mt-6 w-full sm:w-auto"
              data-feedback-submit
              type="submit"
            >
              {t('feedback.send')}
            </button>

            <p
              class="nn-notice nn-notice--error mt-5"
              data-feedback-submission-error
              role="alert"
              tabindex="-1"
              hidden
            ></p>
          </form>
        </Surface>
      </div>

      <section
        class="nn-notice nn-notice--info flex-col"
        data-feedback-success
        role="status"
        aria-live="polite"
        aria-labelledby="feedback-success-title"
        tabindex="-1"
        hidden
      >
        <h2 class="nn-type-section-title" id="feedback-success-title">
          {t('feedback.successTitle')}
        </h2>
        <p class="nn-type-body-small">
          {t('feedback.successBody')}
        </p>
        <button
          class="nn-button nn-button--secondary mt-3 self-start"
          data-feedback-submit-another
          type="button"
        >
          {t('feedback.sendAnother')}
        </button>
      </section>
    </section>
  </main>
</SiteLayout>

<script>
  import { initializePrivateFeedback } from '@/features/feedback/private-feedback';

  const root = document.querySelector<HTMLElement>('[data-feedback-page]');
  const loading = root?.querySelector<HTMLElement>('[data-feedback-loading]');
  const sessionError = root?.querySelector<HTMLElement>('[data-feedback-session-error]');
  const formContainer = root?.querySelector<HTMLElement>('[data-feedback-form-container]');
  const form = root?.querySelector<HTMLFormElement>('[data-feedback-form]');
  const category = root?.querySelector<HTMLSelectElement>('#feedback-category');
  const categoryError = root?.querySelector<HTMLElement>('[data-feedback-category-error]');
  const message = root?.querySelector<HTMLTextAreaElement>('#feedback-message');
  const messageCount = root?.querySelector<HTMLElement>('[data-feedback-message-count]');
  const messageError = root?.querySelector<HTMLElement>('[data-feedback-message-error]');
  const submit = root?.querySelector<HTMLButtonElement>('[data-feedback-submit]');
  const submissionError = root?.querySelector<HTMLElement>('[data-feedback-submission-error]');
  const success = root?.querySelector<HTMLElement>('[data-feedback-success]');
  const submitAnother = root?.querySelector<HTMLButtonElement>('[data-feedback-submit-another]');

  if (
    root && loading && sessionError && formContainer && form && category &&
    categoryError && message && messageCount && messageError && submit &&
    submissionError && success && submitAnother
  ) {
    initializePrivateFeedback({
      root,
      loading,
      sessionError,
      formContainer,
      form,
      category,
      categoryError,
      message,
      messageCount,
      messageError,
      submit,
      submissionError,
      success,
      submitAnother
    });
  }
</script>
