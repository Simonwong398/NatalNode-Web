---
import { getCollection } from 'astro:content';
import Page from '../../learn/[slug].astro';
import { parseSupportedLocale, SUPPORTED_LOCALES } from '@/lib/localization';

export async function getStaticPaths() {
  const entries = await getCollection('learn', ({ data }) => !data.draft);

  return SUPPORTED_LOCALES.flatMap((locale) =>
    entries
      .filter((entry) => entry.data.locale === locale)
      .map((entry) => ({
        params: { locale, slug: entry.data.contentId },
        props: { entry, locale }
      }))
  );
}

const locale = parseSupportedLocale(Astro.params.locale);
if (locale === null) {
  throw new Error('Unsupported locale route parameter');
}
---

<Page entry={Astro.props.entry} locale={locale} />
