---
import SavedVaultChartExperience from '@/features/vault/SavedVaultChartExperience';
import SiteLayout from '@/layouts/SiteLayout.astro';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Saved Chart | NatalNode',
  description: 'View a saved NatalNode chart.',
  canonical: '/vault/chart',
  robots: 'noindex,nofollow'
};
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--workspace pb-20 pt-8 sm:pt-12">
    <a class="nn-button nn-button--quiet -ml-3" href="/vault">
      ← Back to Vault
    </a>
    <header class="mt-8 max-w-3xl">
      <p class="nn-eyebrow">Vault</p>
      <h1 class="nn-type-page-title mt-3">
        Saved chart
      </h1>
    </header>

    <section class="mt-8 max-w-5xl" aria-label="Saved chart">
      <SavedVaultChartExperience client:load />
    </section>
  </main>
</SiteLayout>
