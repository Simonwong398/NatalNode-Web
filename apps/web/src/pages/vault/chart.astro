---
import SavedVaultChartExperience from '@/features/vault/SavedVaultChartExperience';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Saved Chart | NatalNode',
  description: 'View a saved NatalNode chart.',
  canonical: '/vault/chart',
  robots: 'noindex,nofollow'
};
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--workspace pb-20 pt-8 sm:pt-12">
    <a class="nn-button nn-button--quiet -ml-3" href={localize('/vault')}>
      {t('vault.backToVault')}
    </a>
    <header class="mt-8 max-w-3xl">
      <p class="nn-eyebrow">{t('nav.vault')}</p>
      <h1 class="nn-type-page-title mt-3">
        {t('vault.savedChartTitle')}
      </h1>
    </header>

    <section class="mt-8 max-w-5xl" aria-label={t('vault.savedChartTitle')}>
      <SavedVaultChartExperience client:load locale={locale} />
    </section>
  </main>
</SiteLayout>
