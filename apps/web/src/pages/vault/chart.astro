---
import SavedVaultChartExperience from '@/features/vault/SavedVaultChartExperience';
import SiteLayout from '@/layouts/SiteLayout.astro';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Saved Chart | NatalNode',
  description: 'View a saved NatalNode chart.',
  canonical: '/vault/chart',
  robots: 'noindex,nofollow'
};
---

<SiteLayout seo={seo}>
  <main class="mx-auto w-[calc(100%-2rem)] max-w-5xl pb-16 pt-10 sm:pt-14">
    <a class="text-sm text-natal-accent transition-colors hover:text-white" href="/vault">
      ← Back to Vault
    </a>
    <header class="mt-8 max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Vault</p>
      <h1 class="mt-3 text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-5xl">
        Saved chart
      </h1>
    </header>

    <section class="mt-10" aria-label="Saved chart">
      <SavedVaultChartExperience client:load />
    </section>
  </main>
</SiteLayout>
