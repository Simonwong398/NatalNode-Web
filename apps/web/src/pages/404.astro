---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Page not found | NatalNode',
  description: 'The requested NatalNode page could not be found.',
  canonical: '/404',
  robots: 'noindex,follow'
};
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial flex min-h-[70vh] items-center py-16 sm:py-24">
    <section class="max-w-2xl" aria-labelledby="not-found-title">
      <p class="nn-eyebrow">404 · PAGE NOT FOUND</p>
      <h1 class="nn-type-page-title mt-3" id="not-found-title">This path doesn't resolve.</h1>
      <p class="nn-type-body mt-4 max-w-xl">
        The page may have moved, or the address may be incorrect.
      </p>

      <a class="nn-button nn-button--primary mt-8" href={localize('/')}>Calculate a chart</a>

      <nav class="mt-10 border-t border-natal-border/70 pt-6" aria-label="Page recovery links">
        <p class="nn-type-metadata">Continue to</p>
        <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
          <li>
            <a
              class="font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
              href={localize('/learn/')}
            >
              Learn
            </a>
          </li>
          <li>
            <a
              class="font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
              href={localize('/tools/')}
            >
              Tools
            </a>
          </li>
          <li>
            <a
              class="font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
              href={localize('/')}
            >
              Home
            </a>
          </li>
        </ul>
      </nav>
    </section>
  </main>
</SiteLayout>
