---
import ScaffoldStatus from '../components/ScaffoldStatus';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Minimal Astro, React, and TypeScript scaffold for NatalNode.com."
    />
    <title>NatalNode — Web Scaffold</title>
  </head>
  <body>
    <main class="shell">
      <p class="eyebrow">NatalNode</p>
      <h1>Professional natal charts, built for transparency.</h1>
      <p class="intro">
        A minimal website shell for the NatalNode Engine’s first-party web experience.
      </p>
      <ScaffoldStatus client:load />
    </main>
  </body>
</html>
