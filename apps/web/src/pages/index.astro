---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { ChartExperience } from '@/features/chart-experience';

const seo = {
  title: 'NatalNode — Birth Input',
  description: 'Enter the birth details needed to begin a NatalNode chart.',
  canonical: '/'
} as const;
---

<SiteLayout seo={seo} mode="observatory">
  <main class="nn-container nn-container--calculate nn-calculate-page flex min-h-screen flex-col pb-12 pt-10 sm:pt-14">
    <svg
      aria-hidden="true"
      class="nn-calculate-grid"
      focusable="false"
      preserveAspectRatio="xMidYMid slice"
      viewBox="0 0 1200 960"
    >
      <g class="nn-calculate-grid__line" fill="none" stroke="currentColor">
        <ellipse cx="900" cy="290" rx="310" ry="170" />
        <ellipse cx="900" cy="290" rx="310" ry="78" />
        <path d="M590 290C656 88 1144 88 1210 290C1144 492 656 492 590 290Z" />
        <path d="M900 120C760 198 760 382 900 460" />
        <path d="M900 120C1040 198 1040 382 900 460" />
        <path d="M650 520C825 430 1030 448 1200 560" />
        <path d="M0 755C250 640 492 660 705 760S1060 900 1200 795" />
        <path d="M0 178C240 130 440 150 620 214" />
      </g>
      <g class="nn-calculate-grid__marker" fill="currentColor">
        <circle cx="650" cy="520" r="2" />
        <circle cx="900" cy="290" r="2.5" />
        <circle cx="1055" cy="290" r="2" />
        <circle cx="705" cy="760" r="2" />
      </g>
    </svg>
    <header class="nn-section-header">
      <p class="nn-eyebrow">Calculate</p>
      <h1 class="nn-type-page-title max-w-2xl">Create your birth chart</h1>
      <p class="nn-type-body max-w-xl">Enter the birth details you know.</p>
    </header>
    <ChartExperience client:load />
  </main>
</SiteLayout>
