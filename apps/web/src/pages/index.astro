---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { ChartExperience } from '@/features/chart-experience';

const seo = {
  title: 'NatalNode — Birth Input',
  description: 'Enter the birth details needed to begin a NatalNode chart.',
  canonical: '/'
} as const;
---

<SiteLayout seo={seo} mode="observatory">
  <main class="nn-container nn-container--form flex min-h-screen flex-col pb-12 pt-12 sm:pt-20">
    <header class="nn-section-header">
      <p class="nn-eyebrow">NatalNode</p>
      <h1 class="nn-type-display max-w-2xl">
        Start with the birth details you know.
      </h1>
      <p class="nn-type-body max-w-xl">
        NatalNode keeps location and time resolution explicit before a chart is calculated.
      </p>
    </header>
    <ChartExperience client:load />
  </main>
</SiteLayout>
