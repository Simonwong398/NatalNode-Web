---
import SeoHead from '@/components/SeoHead.astro';
import { ChartExperience } from '@/features/chart-experience';
import '@/styles/global.css';

const seo = {
  title: 'NatalNode — Birth Input',
  description: 'Enter the birth details needed to begin a NatalNode chart.',
  canonical: '/'
} as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead seo={seo} />
  </head>
  <body>
    <main class="mx-auto flex min-h-screen w-[calc(100%-2rem)] max-w-3xl flex-col pb-12 pt-16 sm:pt-28">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">NatalNode</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-semibold leading-[0.98] tracking-[-0.055em] text-white sm:text-7xl">
        Start with the birth details you know.
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-7 text-natal-muted">
        NatalNode keeps location and time resolution explicit before a chart is calculated.
      </p>
      <ChartExperience client:load />
    </main>
  </body>
</html>
