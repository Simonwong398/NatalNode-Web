---
import SiteLayout from '@/layouts/SiteLayout.astro';
import {
  ELEMENT_MEANINGS,
  MODALITY_MEANINGS,
  SIGN_OPTIONS
} from '@/lib/sign-lookup';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Zodiac Sign Lookup: Understand the 12 Signs | NatalNode',
  description: 'Select one of the twelve zodiac signs to explore its element, modality, and interpretive themes in a focused educational lookup.',
  canonical: '/tools/sign-lookup'
};
---

<SiteLayout seo={seo}>
  <main class="mx-auto w-[calc(100%-2rem)] max-w-5xl pb-16 pt-14 sm:pt-20">
    <header class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Tools / Sign Lookup</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-6xl">
        Explore a zodiac sign
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-natal-muted">
        Select one sign to explore the symbolic element, modality, and interpretive themes associated with it.
      </p>
    </header>

    <section class="mt-12 max-w-4xl rounded-2xl border border-natal-border bg-natal-surface/75 p-5 sm:p-8" aria-labelledby="sign-selection-title">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Make a selection</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="sign-selection-title">
          Choose a zodiac sign
        </h2>
      </div>

      <form class="mt-6" data-sign-lookup-form aria-describedby="sign-lookup-boundary">
        <label class="text-sm font-medium text-slate-100" for="zodiac-sign">Zodiac sign</label>
        <select
          class="mt-2 block min-h-11 w-full max-w-md rounded-lg border border-natal-border bg-slate-950/40 px-3 py-2.5 text-sm text-white outline-none focus-visible:border-natal-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-natal-accent"
          id="zodiac-sign"
          name="sign"
          data-sign-select
          required
        >
          <option value="">Choose a sign</option>
          {SIGN_OPTIONS.map((sign) => <option value={sign.id}>{sign.label}</option>)}
        </select>

        <p class="mt-5 rounded-xl border border-amber-200/20 bg-amber-200/5 p-4 text-sm leading-6 text-slate-300" id="sign-lookup-boundary">
          This tool explains a zodiac sign you select. It does not calculate a sign from your birth date or planetary position.
        </p>

        <button
          class="mt-5 inline-flex min-h-10 items-center justify-center rounded-lg border border-natal-border px-4 py-2 text-sm font-semibold text-slate-200 hover:border-natal-accent hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-natal-accent"
          type="reset"
        >
          Clear selection
        </button>
      </form>
    </section>

    <section
      class="mt-6 max-w-4xl rounded-2xl border border-natal-border bg-natal-surface/75 p-5 sm:p-8"
      data-sign-result
      aria-live="polite"
      aria-labelledby="sign-result-title"
      hidden
    >
      <div data-sign-result-content></div>
    </section>
    <p class="mt-6 max-w-3xl text-sm leading-7 text-natal-muted" data-sign-empty role="status">
      Choose a zodiac sign to see a focused interpretation. No sign is preselected.
    </p>
    <noscript>
      <p class="mt-4 max-w-3xl text-sm leading-7 text-amber-100">
        JavaScript is required to generate the selected interpretation in this browser.
      </p>
    </noscript>

    <div class="mt-14 grid gap-10 border-t border-natal-border/70 pt-10 lg:grid-cols-2">
      <section aria-labelledby="what-signs-represent-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">What signs represent</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="what-signs-represent-title">
          A vocabulary for style
        </h2>
        <p class="mt-4 text-sm leading-7 text-natal-muted">
          In astrology, zodiac signs are interpretive categories used to describe ways a theme may be expressed. A sign can offer language for qualities such as directness, patience, curiosity, or sensitivity; it does not define a person or determine what they will do.
        </p>
      </section>

      <section aria-labelledby="elements-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Elements</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="elements-title">
          Four symbolic lenses
        </h2>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-natal-muted">
          {Object.entries(ELEMENT_MEANINGS).map(([element, description]) => (
            <li><strong class="font-semibold text-slate-100">{element}:</strong> {description}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="modalities-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Modalities</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="modalities-title">
          Three ways energy is described
        </h2>
        <ul class="mt-4 space-y-3 text-sm leading-7 text-natal-muted">
          {Object.entries(MODALITY_MEANINGS).map(([modality, description]) => (
            <li><strong class="font-semibold text-slate-100">{modality}:</strong> {description}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="how-to-use-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">How to use the lookup</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="how-to-use-title">
          Read the result as a starting point
        </h2>
        <p class="mt-4 text-sm leading-7 text-natal-muted">
          Begin with the element and modality, then notice how the core style and constructive expression fit together. The potential tension is an invitation to reflect on balance, not a prediction or a fixed label. You can compare this tool with the <a class="text-natal-accent underline decoration-natal-accent/50 underline-offset-4 hover:text-white" href="/tools/aspect-lookup">Aspect Lookup</a> when you want to explore another piece of astrology vocabulary.
        </p>
      </section>

      <section class="lg:col-span-2" aria-labelledby="calculation-disclosure-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Calculation vs interpretation</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="calculation-disclosure-title">
          An explanation, not a sign calculator
        </h2>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-natal-muted">
          This tool explains a zodiac sign you select. It does not calculate a sign from your birth date or planetary position, and it does not claim scientific validation for astrological interpretation. For an introduction to chart inputs and calculation boundaries, read <a class="text-natal-accent underline decoration-natal-accent/50 underline-offset-4 hover:text-white" href="/learn/what-is-a-natal-chart">What Is a Natal Chart?</a> or return to the <a class="text-natal-accent underline decoration-natal-accent/50 underline-offset-4 hover:text-white" href="/tools/">Tools hub</a>.
        </p>
      </section>
    </div>
  </main>
</SiteLayout>

<script>
  import { initializeSignLookup } from '@/lib/sign-lookup';

  initializeSignLookup();
</script>
