---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { SIGN_OPTIONS } from '@/lib/sign-lookup';
import {
  resolveAstrologyDomainTerm,
  type AstrologyGlossaryDomainKind
} from '@/core/astrology-taxonomy/astrology-glossary';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import { getToolDetailCopy } from '@/lib/tools-detail-copy';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Zodiac Sign Lookup: Understand the 12 Signs | NatalNode',
  description: 'Select one of the twelve zodiac signs to explore its element, modality, and interpretive themes in a focused educational lookup.',
  canonical: '/tools/sign-lookup'
};
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
const copy = getToolDetailCopy(locale);
const ui = (key: UiMessageKey): string => getUiMessage(locale, key);
const glossaryTerm = (kind: AstrologyGlossaryDomainKind, value: unknown): string =>
  resolveAstrologyDomainTerm(kind, value, locale)?.displayTerm ??
  (typeof value === 'string' ? value : String(value));
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial nn-tools-page nn-tools-detail pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl nn-tools-detail__header">
      <p class="nn-eyebrow">{ui('tools.eyebrow')} / {ui('tools.signLookup')}</p>
      <h1 class="nn-type-page-title mt-3">
        {copy.sign.title}
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        {copy.sign.description}
      </p>
    </header>

    <section class="nn-surface nn-surface--elevated nn-tools-task-surface mt-12 max-w-4xl p-5 sm:p-8" aria-labelledby="sign-selection-title">
      <div class="nn-section-header">
        <p class="nn-eyebrow">{copy.common.makeSelection}</p>
        <h2 class="nn-type-section-title" id="sign-selection-title">
          {copy.sign.selectionTitle}
        </h2>
      </div>

      <form class="mt-8" data-glossary-locale={locale} data-sign-lookup-form aria-describedby="sign-lookup-boundary">
        <label class="nn-type-label" for="zodiac-sign">{copy.sign.fieldLabel}</label>
        <select
          class="nn-field mt-2 max-w-md"
          id="zodiac-sign"
          name="sign"
          data-sign-select
          required
        >
          <option value="">{copy.sign.optionPlaceholder}</option>
          {SIGN_OPTIONS.map((sign) => <option value={sign.id}>{glossaryTerm('sign', sign.label)}</option>)}
        </select>

        <p class="nn-notice nn-notice--trust mt-6 max-w-3xl" id="sign-lookup-boundary">
          {copy.sign.boundary}
        </p>

        <button
          class="nn-button nn-button--quiet mt-5"
          type="reset"
        >
          {copy.common.clearSelection}
        </button>
      </form>
    </section>

    <section
      class="nn-surface nn-tools-result-surface mt-8 max-w-4xl p-5 sm:p-8"
      data-sign-result
      aria-live="polite"
      aria-labelledby="sign-result-title"
      hidden
    >
      <div data-sign-result-content></div>
    </section>
    <p class="nn-async-state nn-async-state--empty mt-6 max-w-3xl" data-sign-empty role="status">
      {copy.sign.empty}
    </p>
    <noscript>
      <p class="nn-notice nn-notice--info mt-4 max-w-3xl">
        {copy.common.noscript}
      </p>
    </noscript>

    <div class="nn-tools-explanation mt-16 grid gap-12 border-t border-natal-border/70 pt-12 lg:grid-cols-2 lg:gap-x-10 lg:gap-y-14 lg:pt-16">
      <section aria-labelledby="what-signs-represent-title">
        <p class="nn-eyebrow">{copy.sign.representEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="what-signs-represent-title">
          {copy.sign.representTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.sign.representDescription}
        </p>
      </section>

      <section aria-labelledby="elements-title">
        <p class="nn-eyebrow">{copy.sign.elementsEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="elements-title">
          {copy.sign.elementsTitle}
        </h2>
        <ul class="mt-4 space-y-3 nn-type-body">
          {Object.entries(copy.sign.elementMeanings).map(([element, description]) => (
            <li><strong class="font-semibold text-natal-primary">{glossaryTerm('sign_element', element)}:</strong> {description}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="modalities-title">
        <p class="nn-eyebrow">{copy.sign.modalitiesEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="modalities-title">
          {copy.sign.modalitiesTitle}
        </h2>
        <ul class="mt-4 space-y-3 nn-type-body">
          {Object.entries(copy.sign.modalityMeanings).map(([modality, description]) => (
            <li><strong class="font-semibold text-natal-primary">{glossaryTerm('sign_modality', modality)}:</strong> {description}</li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="how-to-use-title">
        <p class="nn-eyebrow">{copy.sign.howEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="how-to-use-title">
          {copy.sign.howTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.sign.howDescription}
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/tools/aspect-lookup')}>{ui('tools.aspectLookup')}</a>
        </p>
      </section>

      <section class="lg:col-span-2" aria-labelledby="calculation-disclosure-title">
        <p class="nn-eyebrow">{copy.sign.calculationEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="calculation-disclosure-title">
          {copy.sign.calculationTitle}
        </h2>
        <p class="nn-type-body mt-4 max-w-3xl">
          {copy.sign.calculationDescription}
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/learn/what-is-a-natal-chart')}>{ui('learn.landing.article.foundationsTitle')}</a>
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/tools/')}>{ui('tools.referenceTools')}</a>
        </p>
      </section>
    </div>
  </main>
</SiteLayout>

<script>
  import { initializeSignLookup } from '@/lib/sign-lookup';

  initializeSignLookup();
</script>
