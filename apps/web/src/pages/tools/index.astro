---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { SEO_TOOL_TAXONOMY } from '@/lib/content-taxonomy';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Astrology Tools | NatalNode',
  description: 'A clear home for future NatalNode utilities built around useful transformations and educational lookup.',
  canonical: '/tools/'
};

const availableTools = SEO_TOOL_TAXONOMY.filter((tool) => tool.status === 'AVAILABLE');
---

<SiteLayout seo={seo}>
  <main class="mx-auto w-[calc(100%-2rem)] max-w-5xl pb-16 pt-14 sm:pt-20">
    <header class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Tools</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] text-white sm:text-6xl">
        Useful astrology utilities, kept focused.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-natal-muted">
        This public surface is reserved for standalone tools that answer a focused question or make a chart concept easier to understand.
      </p>
    </header>

    <section class="mt-14" aria-labelledby="available-tools-title">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Available now</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="available-tools-title">
        Start with a focused question
      </h2>
      <ul class="mt-6 grid gap-4 sm:max-w-3xl">
        {availableTools.map((tool) => (
          <li class="rounded-2xl border border-natal-border bg-natal-surface/75 p-6">
            <h3 class="text-xl font-semibold text-white">
              <a class="hover:text-natal-accent" href={tool.intendedPath}>{tool.label}</a>
            </h3>
            <p class="mt-2 text-sm leading-7 text-natal-muted">{tool.purpose}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12 max-w-3xl rounded-2xl border border-natal-border bg-natal-surface/75 p-6 sm:p-8" aria-labelledby="tools-principles-title">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-natal-accent">Foundation</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-white" id="tools-principles-title">
        Keep the directory useful
      </h2>
      <div class="mt-4 space-y-4 text-sm leading-7 text-natal-muted">
        <p>
          {availableTools.length} focused utilities are currently available for stable educational lookup and transformations that do not need a browser astronomy engine.
        </p>
        <p>
          Additional utility concepts will be linked only when their functionality exists, keeping the directory useful instead of filling it with placeholder inventory.
        </p>
      </div>
      <a class="mt-6 inline-flex text-sm font-semibold text-natal-accent hover:text-white" href="/">
        Open the chart workspace →
      </a>
    </section>
  </main>
</SiteLayout>
