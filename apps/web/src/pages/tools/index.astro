---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { SEO_TOOL_TAXONOMY } from '@/lib/content-taxonomy';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Astrology Reference Tools | NatalNode',
  description: 'Explore clear reference tools for signs, houses, and aspects, or start a NatalNode chart calculation.',
  canonical: '/tools/'
};

const availableTools = SEO_TOOL_TAXONOMY.filter((tool) => tool.status === 'AVAILABLE');
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial nn-tools-page nn-tools-hub pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl nn-tools-hub__header">
      <p class="nn-eyebrow">Tools</p>
      <h1 class="nn-type-page-title mt-3">
        Reference tools for the building blocks of a chart.
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        Use these focused educational lookups to understand signs, houses, and aspects without performing a full natal-chart calculation.
      </p>
    </header>

    <section class="mt-12 max-w-5xl nn-tools-hub__directory" aria-labelledby="available-tools-title">
      <div class="nn-section-header max-w-2xl">
        <p class="nn-eyebrow">Reference tools</p>
        <h2 class="nn-type-section-title" id="available-tools-title">
          Start with a focused question
        </h2>
      </div>
      <ul class="mt-8 grid gap-5 md:grid-cols-3 nn-tools-card-grid">
        {availableTools.map((tool) => (
          <li class="nn-surface nn-tools-card flex min-w-0 flex-col p-5 sm:p-6">
            <h3 class="nn-type-card-title nn-tools-card__title">
              <a
                class="nn-tools-card__link font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
                href={localize(tool.intendedPath)}
              >
                {tool.label}
              </a>
            </h3>
            <p class="nn-type-body-small mt-3">{tool.purpose}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 max-w-3xl border-t border-natal-border/70 pt-12 nn-tools-hub__support" aria-labelledby="tools-principles-title">
      <div class="nn-section-header">
        <p class="nn-eyebrow">Foundation</p>
        <h2 class="nn-type-section-title" id="tools-principles-title">
        Keep the directory useful
        </h2>
      </div>
      <div class="mt-5 space-y-4 nn-type-body">
        <p>
          {availableTools.length} reference tools are currently available for educational lookup and interpretation of chart building blocks. They do not calculate a natal chart.
        </p>
        <p>
          Additional utility concepts will be linked only when their functionality exists, keeping the directory useful instead of filling it with placeholder inventory.
        </p>
      </div>
      <p class="nn-type-body-small mt-6">Looking to calculate a natal chart?</p>
      <a class="nn-button nn-button--quiet mt-2" href={localize('/')}>
        Calculate a chart →
      </a>
    </section>
  </main>
</SiteLayout>
