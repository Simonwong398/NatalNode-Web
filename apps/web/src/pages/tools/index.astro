---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getAstrologyGlyph, getAstrologyNotation } from '@/core/astrology-taxonomy/AstrologyGlyph';
import { SEO_TOOL_TAXONOMY } from '@/lib/content-taxonomy';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import type { SeoMetadata } from '@/lib/seo';
import { formatUiMessage, getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';

const seo: SeoMetadata = {
  title: 'Astrology Reference Tools | NatalNode',
  description: 'Explore clear reference tools for signs, houses, and aspects, or start a NatalNode chart calculation.',
  canonical: '/tools/'
};

const availableTools = SEO_TOOL_TAXONOMY.filter((tool) => tool.status === 'AVAILABLE');
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);

const toolCopy = {
  '/tools/sign-lookup': {
    label: 'tools.signLookup',
    purpose: 'tools.signLookupPurpose'
  },
  '/tools/house-lookup': {
    label: 'tools.houseLookup',
    purpose: 'tools.houseLookupPurpose'
  },
  '/tools/aspect-lookup': {
    label: 'tools.aspectLookup',
    purpose: 'tools.aspectLookupPurpose'
  }
} as const satisfies Record<string, { label: UiMessageKey; purpose: UiMessageKey }>;

function toolNotation(path: string): string | undefined {
  switch (path) {
    case '/tools/sign-lookup':
      return getAstrologyGlyph('sign', 'Aries');
    case '/tools/house-lookup':
      return getAstrologyNotation('house', 1, 'romanNumeral');
    case '/tools/aspect-lookup':
      return getAstrologyGlyph('aspect', 'conjunction');
    default:
      return undefined;
  }
}
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial nn-tools-page nn-tools-hub pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl nn-tools-hub__header">
      <p class="nn-eyebrow">{t('tools.eyebrow')}</p>
      <h1 class="nn-type-page-title mt-3">
        {t('tools.title')}
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        {t('tools.description')}
      </p>
    </header>

    <section class="mt-12 max-w-5xl nn-tools-hub__directory" aria-labelledby="available-tools-title">
      <div class="nn-section-header max-w-2xl">
        <p class="nn-eyebrow">{t('tools.referenceTools')}</p>
        <h2 class="nn-type-section-title" id="available-tools-title">
          {t('tools.startQuestion')}
        </h2>
      </div>
      <ul class="mt-8 grid gap-5 md:grid-cols-3 nn-tools-card-grid">
        {availableTools.map((tool) => (
          <li class="nn-surface nn-tools-card flex min-w-0 flex-col p-5 sm:p-6">
            <h3 class="nn-type-card-title nn-tools-card__title">
              {toolNotation(tool.intendedPath) ? (
                <span aria-hidden="true" class="nn-astrology-glyph mr-2 text-natal-accent">
                  {toolNotation(tool.intendedPath)}
                </span>
              ) : null}
              <a
                class="nn-tools-card__link font-semibold underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-natal-accent"
                href={localize(tool.intendedPath)}
              >
                {toolCopy[tool.intendedPath]?.label
                  ? t(toolCopy[tool.intendedPath].label)
                  : tool.label}
              </a>
            </h3>
            <p class="nn-type-body-small mt-3">
              {toolCopy[tool.intendedPath]?.purpose
                ? t(toolCopy[tool.intendedPath].purpose)
                : tool.purpose}
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-16 max-w-3xl border-t border-natal-border/70 pt-12" aria-labelledby="discover-entry-title">
      <p class="nn-eyebrow">{t('discover.entryEyebrow')}</p>
      <h2 class="nn-type-section-title mt-2" id="discover-entry-title">
        {t('discover.entryTitle')}
      </h2>
      <p class="nn-type-body mt-4 max-w-2xl">
        {t('discover.entryDescription')}
      </p>
      <a class="nn-button nn-button--secondary mt-6" href={localize('/discover/')}>
        {t('discover.entryAction')}
      </a>
    </section>

    <section class="mt-16 max-w-3xl border-t border-natal-border/70 pt-12 nn-tools-hub__support" aria-labelledby="tools-principles-title">
      <div class="nn-section-header">
        <p class="nn-eyebrow">{t('tools.foundation')}</p>
        <h2 class="nn-type-section-title" id="tools-principles-title">
          {t('tools.keepDirectoryUseful')}
        </h2>
      </div>
      <div class="mt-5 space-y-4 nn-type-body">
        <p>
          {formatUiMessage(locale, 'tools.availableSummary', { count: availableTools.length })}
        </p>
        <p>
          {t('tools.additionalUtility')}
        </p>
      </div>
      <p class="nn-type-body-small mt-6">{t('tools.calculatePrompt')}</p>
      <a class="nn-button nn-button--quiet mt-2" href={localize('/')}>
        {t('tools.calculateAction')}
      </a>
    </section>
  </main>
</SiteLayout>
