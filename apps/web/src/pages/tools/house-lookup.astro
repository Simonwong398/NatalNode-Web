---
import SiteLayout from '@/layouts/SiteLayout.astro';
import { HOUSE_OPTIONS } from '@/lib/house-lookup';
import {
  resolveAstrologyDomainTerm,
  type AstrologyGlossaryDomainKind
} from '@/core/astrology-taxonomy/astrology-glossary';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import { getToolDetailCopy } from '@/lib/tools-detail-copy';
import { createPublicSeo } from '@/lib/public-seo';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
const copy = getToolDetailCopy(locale);
const ui = (key: UiMessageKey): string => getUiMessage(locale, key);
const seo = createPublicSeo(
  locale,
  '/tools/house-lookup',
  `${copy.house.title} | NatalNode`,
  copy.house.description
);
const glossaryTerm = (kind: AstrologyGlossaryDomainKind, value: unknown): string =>
  resolveAstrologyDomainTerm(kind, value, locale)?.displayTerm ??
  (typeof value === 'string' ? value : String(value));
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial nn-tools-page nn-tools-detail pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl nn-tools-detail__header">
      <p class="nn-eyebrow">{ui('tools.eyebrow')} / {ui('tools.houseLookup')}</p>
      <h1 class="nn-type-page-title mt-3">
        {copy.house.title}
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        {copy.house.description}
      </p>
    </header>

    <section class="nn-surface nn-surface--elevated nn-tools-task-surface mt-12 max-w-4xl p-5 sm:p-8" aria-labelledby="house-selection-title">
      <div class="nn-section-header">
        <p class="nn-eyebrow">{copy.common.makeSelection}</p>
        <h2 class="nn-type-section-title" id="house-selection-title">
          {copy.house.selectionTitle}
        </h2>
      </div>

      <form class="mt-8" data-glossary-locale={locale} data-house-lookup-form aria-describedby="house-lookup-boundary">
        <label class="nn-type-label" for="astrological-house">{copy.house.fieldLabel}</label>
        <select
          class="nn-field mt-2 max-w-md"
          id="astrological-house"
          name="house"
          data-house-select
          required
        >
          <option value="">{copy.house.optionPlaceholder}</option>
          {HOUSE_OPTIONS.map((house) => <option value={house.id}>{glossaryTerm('house', house.number)}</option>)}
        </select>

        <p class="nn-notice nn-notice--trust mt-6 max-w-3xl" id="house-lookup-boundary">
          {copy.house.boundary}
        </p>

        <button
          class="nn-button nn-button--quiet mt-5"
          type="reset"
        >
          {copy.common.clearSelection}
        </button>
      </form>
    </section>

    <section
      class="nn-surface nn-tools-result-surface mt-8 max-w-4xl p-5 sm:p-8"
      data-house-result
      aria-live="polite"
      aria-labelledby="house-result-title"
      hidden
    >
      <div data-house-result-content></div>
    </section>
    <p class="nn-async-state nn-async-state--empty mt-6 max-w-3xl" data-house-empty role="status">
      {copy.house.empty}
    </p>
    <noscript>
      <p class="nn-notice nn-notice--info mt-4 max-w-3xl">
        {copy.common.noscript}
      </p>
    </noscript>

    <div class="nn-tools-explanation mt-16 grid gap-12 border-t border-natal-border/70 pt-12 lg:grid-cols-2 lg:gap-x-10 lg:gap-y-14 lg:pt-16">
      <section aria-labelledby="what-houses-represent-title">
        <p class="nn-eyebrow">{copy.house.representEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="what-houses-represent-title">
          {copy.house.representTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.house.representDescription}
        </p>
      </section>

      <section aria-labelledby="house-sequence-title">
        <p class="nn-eyebrow">{copy.house.sequenceEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="house-sequence-title">
          {copy.house.sequenceTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.house.sequenceDescription}
        </p>
      </section>

      <section aria-labelledby="birth-time-title">
        <p class="nn-eyebrow">{copy.house.timeEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="birth-time-title">
          {copy.house.timeTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.house.timeDescription}
        </p>
      </section>

      <section aria-labelledby="how-to-use-title">
        <p class="nn-eyebrow">{copy.house.howEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="how-to-use-title">
          {copy.house.howTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.house.howDescription}
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/tools/sign-lookup')}>{ui('tools.signLookup')}</a>
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/tools/aspect-lookup')}>{ui('tools.aspectLookup')}</a>
        </p>
      </section>

      <section class="lg:col-span-2" aria-labelledby="calculation-disclosure-title">
        <p class="nn-eyebrow">{copy.house.calculationEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="calculation-disclosure-title">
          {copy.house.calculationTitle}
        </h2>
        <p class="nn-type-body mt-4 max-w-3xl">
          {copy.house.calculationDescription}
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/learn/what-is-a-natal-chart')}>{ui('learn.landing.article.foundationsTitle')}</a>
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/tools/')}>{ui('tools.referenceTools')}</a>
        </p>
      </section>
    </div>
  </main>
</SiteLayout>

<script>
  import { initializeHouseLookup } from '@/lib/house-lookup';

  initializeHouseLookup();
</script>
