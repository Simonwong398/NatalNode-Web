---
import SiteLayout from '@/layouts/SiteLayout.astro';
import {
  ASPECT_OPTIONS,
  SUPPORTED_PLANETS
} from '@/lib/aspect-lookup';
import {
  resolveAstrologyDomainTerm,
  type AstrologyGlossaryDomainKind
} from '@/core/astrology-taxonomy/astrology-glossary';
import { getLocalizedPath, getPresentationLocale } from '@/lib/localization';
import { getToolDetailCopy } from '@/lib/tools-detail-copy';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import type { SeoMetadata } from '@/lib/seo';

const seo: SeoMetadata = {
  title: 'Aspect Lookup: Understand Planetary Aspects | NatalNode',
  description: 'Choose two planets and a major aspect to explore a clear, deterministic educational interpretation.',
  canonical: '/tools/aspect-lookup'
};
const locale = getPresentationLocale(Astro.url.pathname, Astro.locals.locale);
const localize = (path: string): string => getLocalizedPath(locale, path);
const copy = getToolDetailCopy(locale);
const ui = (key: UiMessageKey): string => getUiMessage(locale, key);
const glossaryTerm = (kind: AstrologyGlossaryDomainKind, value: unknown): string =>
  resolveAstrologyDomainTerm(kind, value, locale)?.displayTerm ??
  (typeof value === 'string' ? value : String(value));
---

<SiteLayout seo={seo}>
  <main class="nn-container nn-container--editorial nn-tools-page nn-tools-detail pb-20 pt-12 sm:pb-24 sm:pt-16">
    <header class="max-w-3xl nn-tools-detail__header">
      <p class="nn-eyebrow">{ui('tools.eyebrow')} / {ui('tools.aspectLookup')}</p>
      <h1 class="nn-type-page-title mt-3">
        {copy.aspect.title}
      </h1>
      <p class="nn-type-body mt-4 max-w-2xl">
        {copy.aspect.description}
      </p>
    </header>

    <section class="nn-surface nn-surface--elevated nn-tools-task-surface mt-12 max-w-4xl p-5 sm:p-8" aria-labelledby="aspect-selection-title">
      <div class="nn-section-header">
        <p class="nn-eyebrow">{copy.common.makeSelection}</p>
        <h2 class="nn-type-section-title" id="aspect-selection-title">
          {copy.aspect.selectionTitle}
        </h2>
      </div>

      <form class="mt-8" data-glossary-locale={locale} data-aspect-lookup-form aria-describedby="aspect-lookup-boundary">
        <div class="grid gap-5 lg:grid-cols-[1fr_auto_1fr] lg:items-end">
          <div>
            <label class="nn-type-label" for="planet-a">{copy.aspect.planetALabel}</label>
            <select
              class="nn-field mt-2"
              id="planet-a"
              name="planetA"
              data-planet-a
              required
            >
              <option value="">{copy.aspect.planetPlaceholder}</option>
              {SUPPORTED_PLANETS.map((planet) => <option value={planet}>{glossaryTerm('body', planet)}</option>)}
            </select>
          </div>

          <div>
            <label class="nn-type-label" for="aspect-type">{copy.aspect.aspectLabel}</label>
            <select
              class="nn-field mt-2 lg:min-w-48"
              id="aspect-type"
              name="aspect"
              data-aspect
              required
            >
              <option value="">{copy.aspect.aspectPlaceholder}</option>
              {ASPECT_OPTIONS.map((aspect) => <option value={aspect.value}>{glossaryTerm('aspect', aspect.value)}</option>)}
            </select>
          </div>

          <div>
            <label class="nn-type-label" for="planet-b">{copy.aspect.planetBLabel}</label>
            <select
              class="nn-field mt-2"
              id="planet-b"
              name="planetB"
              data-planet-b
              required
            >
              <option value="">{copy.aspect.planetPlaceholder}</option>
              {SUPPORTED_PLANETS.map((planet) => <option value={planet}>{glossaryTerm('body', planet)}</option>)}
            </select>
          </div>
        </div>

        <p class="nn-notice nn-notice--trust mt-6 max-w-3xl" id="aspect-lookup-boundary">
          {copy.aspect.boundary}
        </p>

        <button
          class="nn-button nn-button--quiet mt-5"
          type="reset"
        >
          {copy.common.clearSelections}
        </button>
      </form>
    </section>

    <section
      class="nn-surface nn-tools-result-surface mt-8 max-w-4xl p-5 sm:p-8"
      data-aspect-result
      aria-live="polite"
      aria-labelledby="aspect-result-title"
      hidden
    >
      <div data-aspect-result-content></div>
    </section>
    <p class="nn-async-state nn-async-state--empty mt-6 max-w-3xl" data-aspect-empty role="status">
      {copy.aspect.empty}
    </p>
    <noscript>
      <p class="nn-notice nn-notice--info mt-4 max-w-3xl">
        {copy.common.noscript}
      </p>
    </noscript>

    <div class="nn-tools-explanation mt-16 grid gap-12 border-t border-natal-border/70 pt-12 lg:grid-cols-2 lg:gap-x-10 lg:gap-y-14 lg:pt-16">
      <section aria-labelledby="what-this-tool-does-title">
        <p class="nn-eyebrow">{copy.aspect.whatEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="what-this-tool-does-title">
          {copy.aspect.whatTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.aspect.whatDescription}
        </p>
      </section>

      <section aria-labelledby="how-to-use-title">
        <p class="nn-eyebrow">{copy.aspect.howEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="how-to-use-title">
          {copy.aspect.howTitle}
        </h2>
        <p class="nn-type-body mt-4">
          {copy.aspect.howDescription}
        </p>
      </section>

      <section class="lg:col-span-2" aria-labelledby="calculation-disclosure-title">
        <p class="nn-eyebrow">{copy.aspect.calculationEyebrow}</p>
        <h2 class="nn-type-section-title mt-2" id="calculation-disclosure-title">
          {copy.aspect.calculationTitle}
        </h2>
        <p class="nn-type-body mt-4 max-w-3xl">
          {copy.aspect.calculationDescription}
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/learn/what-is-a-natal-chart')}>{ui('learn.landing.article.foundationsTitle')}</a>
          <a class="ml-1 text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white" href={localize('/tools/')}>{ui('tools.referenceTools')}</a>
        </p>
      </section>
    </div>
  </main>
</SiteLayout>

<script>
  import { initializeAspectLookup } from '@/lib/aspect-lookup';

  initializeAspectLookup();
</script>
