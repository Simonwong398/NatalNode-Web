---
import {
  DEFAULT_ROBOTS,
  resolveCanonicalUrl,
  SITE_NAME,
  type SeoMetadata
} from '@/lib/seo';

interface Props {
  seo: SeoMetadata;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  seo,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime
} = Astro.props;
const canonicalUrl = resolveCanonicalUrl(seo.canonical);
const robots = seo.robots ?? DEFAULT_ROBOTS;
const isPublicIndexable = robots === 'index,follow';
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonicalUrl} />
{isPublicIndexable && seo.alternates?.map(({ locale: alternateLocale, url }) => (
  <link rel="alternate" hreflang={alternateLocale} href={resolveCanonicalUrl(url)} />
))}
{isPublicIndexable && (
  <>
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    {seo.ogLocale && <meta property="og:locale" content={seo.ogLocale} />}
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
  </>
)}
