<span
  class="nn-session-control"
  data-auth-session-control
  aria-busy="true"
  hidden
>
  <a
    class="nn-session-control__link nn-button nn-button--quiet"
    data-auth-signed-out
    href="/auth/sign-in"
    hidden
  >
    Sign in
  </a>
  <button
    class="nn-session-control__link nn-button nn-button--quiet"
    data-auth-signed-in
    type="button"
    hidden
  >
    Sign out
  </button>
  <span
    class="nn-session-control__status nn-status nn-status--error"
    data-auth-status
    role="status"
    aria-live="polite"
    hidden
  ></span>
</span>

<script>
  import { initializeAuthSessionControl } from '@/features/auth/auth-session-control';

  const root = document.querySelector<HTMLElement>('[data-auth-session-control]');
  const signedOutLink = root?.querySelector<HTMLAnchorElement>('[data-auth-signed-out]');
  const signedInButton = root?.querySelector<HTMLButtonElement>('[data-auth-signed-in]');
  const statusElement = root?.querySelector<HTMLElement>('[data-auth-status]');

  if (root && signedOutLink && signedInButton && statusElement) {
    initializeAuthSessionControl({
      root,
      signedOutLink,
      signedInButton,
      statusElement
    });
  }
</script>
