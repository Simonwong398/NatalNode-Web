---
const isAccountPage = Astro.url.pathname === '/account';
const isFeedbackPage = Astro.url.pathname === '/feedback';
---

<span
  class="nn-session-control"
  data-auth-session-control
  aria-busy="true"
  hidden
>
  <a
    class="nn-session-control__link nn-button nn-button--quiet"
    data-auth-account
    aria-current={isAccountPage ? 'page' : undefined}
    hidden
  >
    Account
  </a>
  <a
    class="nn-session-control__link nn-button nn-button--quiet"
    data-auth-signed-out
    href="/auth/sign-in"
    hidden
  >
    Sign in
  </a>
  <a
    class="nn-session-control__link nn-button nn-button--quiet"
    data-auth-feedback
    href="/feedback"
    aria-current={isFeedbackPage ? 'page' : undefined}
    hidden
  >
    Feedback
  </a>
  <button
    class="nn-session-control__link nn-button nn-button--quiet"
    data-auth-signed-in
    type="button"
    hidden
  >
    Sign out
  </button>
  <span
    class="nn-session-control__status nn-status nn-status--error"
    data-auth-status
    role="status"
    aria-live="polite"
    hidden
  ></span>
</span>

<script>
  import { initializeAuthSessionControl } from '@/features/auth/auth-session-control';

  const root = document.querySelector<HTMLElement>('[data-auth-session-control]');
  const signedOutLink = root?.querySelector<HTMLAnchorElement>('[data-auth-signed-out]');
  const accountLink = root?.querySelector<HTMLAnchorElement>('[data-auth-account]');
  const feedbackLink = root?.querySelector<HTMLAnchorElement>('[data-auth-feedback]');
  const signedInButton = root?.querySelector<HTMLButtonElement>('[data-auth-signed-in]');
  const statusElement = root?.querySelector<HTMLElement>('[data-auth-status]');

  if (root && signedOutLink && accountLink && feedbackLink && signedInButton && statusElement) {
    initializeAuthSessionControl({
      root,
      signedOutLink,
      accountLink,
      feedbackLink,
      signedInButton,
      statusElement
    });
  }
</script>
