---
import BrandMark from './BrandMark.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['nn-brand-instrument', className]} aria-hidden="true">
  <svg
    viewBox="0 0 520 520"
    role="presentation"
    aria-hidden="true"
    focusable="false"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <radialGradient id="nn-brand-instrument-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22C7D6" stop-opacity="0.13" />
        <stop offset="62%" stop-color="#22C7D6" stop-opacity="0.035" />
        <stop offset="100%" stop-color="#22C7D6" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="nn-brand-instrument-core-sphere" cx="38%" cy="28%" r="76%">
        <stop offset="0%" stop-color="#294A67" stop-opacity="0.92" />
        <stop offset="58%" stop-color="#14263A" stop-opacity="0.96" />
        <stop offset="100%" stop-color="#0B111D" stop-opacity="0.98" />
      </radialGradient>
    </defs>

    <circle
      class="nn-brand-instrument__halo"
      cx="260"
      cy="260"
      r="232"
      fill="url(#nn-brand-instrument-halo)"
    />

    <g
      class="nn-brand-instrument__reference"
      fill="none"
      stroke="#E6E8EB"
      stroke-linecap="round"
      stroke-opacity="0.2"
    >
      <circle cx="260" cy="260" r="224" stroke-width="1" stroke-dasharray="1 18" />
      <path d="M260 18V42M260 478V502M18 260H42M478 260H502" stroke-width="1.5" />
      <path d="M72 72L88 88M432 72L416 88M72 448L88 432M432 448L416 432" stroke-width="1" />
    </g>

    <g
      class="nn-brand-instrument__orbit nn-brand-instrument__orbit--cyan"
      fill="none"
      stroke="#22C7D6"
      stroke-linecap="round"
    >
      <ellipse
        cx="260"
        cy="260"
        rx="211"
        ry="116"
        transform="rotate(-24 260 260)"
        stroke-width="6"
        stroke-opacity="0.12"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="211"
        ry="116"
        transform="rotate(-24 260 260)"
        stroke-width="3.2"
        stroke-opacity="0.9"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="211"
        ry="116"
        transform="rotate(-24 260 260)"
        stroke-width="1"
        stroke-opacity="0.46"
        stroke-dasharray="1 16"
      />
      <circle cx="260" cy="144" r="4.25" fill="#22C7D6" stroke="none" />
      <circle cx="471" cy="260" r="2.5" fill="#22C7D6" stroke="none" opacity="0.8" />
    </g>

    <g
      class="nn-brand-instrument__orbit nn-brand-instrument__orbit--silver"
      fill="none"
      stroke="#E6E8EB"
      stroke-linecap="round"
    >
      <ellipse
        cx="260"
        cy="260"
        rx="158"
        ry="201"
        transform="rotate(38 260 260)"
        stroke-width="5"
        stroke-opacity="0.1"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="158"
        ry="201"
        transform="rotate(38 260 260)"
        stroke-width="2.5"
        stroke-opacity="0.72"
        stroke-dasharray="8 14"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="158"
        ry="201"
        transform="rotate(38 260 260)"
        stroke-width="0.9"
        stroke-opacity="0.4"
        stroke-dasharray="1 11"
      />
      <circle cx="260" cy="59" r="3.5" fill="#E6E8EB" stroke="none" />
      <circle cx="418" cy="260" r="2.25" fill="#E6E8EB" stroke="none" opacity="0.8" />
    </g>

    <g class="nn-brand-instrument__core">
      <g class="nn-brand-instrument__core-sphere" fill="none" stroke-linecap="round">
        <circle
          cx="260"
          cy="260"
          r="104"
          fill="url(#nn-brand-instrument-core-sphere)"
          stroke="var(--nn-brand-cyan, #22C7D6)"
          stroke-opacity="0.5"
          stroke-width="1.6"
        />
        <ellipse
          cx="260"
          cy="260"
          rx="98"
          ry="35"
          stroke="var(--nn-brand-cyan, #22C7D6)"
          stroke-opacity="0.22"
          stroke-width="1"
        />
        <ellipse
          cx="260"
          cy="260"
          rx="35"
          ry="98"
          stroke="var(--nn-brand-silver, #E6E8EB)"
          stroke-opacity="0.16"
          stroke-width="1"
        />
        <path
          d="M190 206C211 184 250 176 285 184"
          stroke="var(--nn-brand-white, #FFFFFF)"
          stroke-opacity="0.16"
          stroke-width="2"
        />
      </g>
      <BrandMark x={165} y={165} size={190} tone="white-cyan" animated />
    </g>
  </svg>
</div>
