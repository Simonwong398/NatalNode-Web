---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['nn-brand-instrument', className]} aria-hidden="true">
  <svg
    viewBox="0 0 520 520"
    role="presentation"
    aria-hidden="true"
    focusable="false"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      <radialGradient id="nn-brand-instrument-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#22C7D6" stop-opacity="0.13" />
        <stop offset="62%" stop-color="#22C7D6" stop-opacity="0.035" />
        <stop offset="100%" stop-color="#22C7D6" stop-opacity="0" />
      </radialGradient>
      <linearGradient
        id="nn-brand-instrument-metal-face"
        x1="164"
        y1="148"
        x2="362"
        y2="372"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0%" stop-color="var(--nn-brand-metal-highlight, #EEF4F7)" />
        <stop offset="24%" stop-color="var(--nn-brand-metal-sheen, #C4D4DD)" />
        <stop offset="52%" stop-color="var(--nn-brand-metal-mid, #8094A5)" />
        <stop offset="76%" stop-color="var(--nn-brand-metal-deep, #1D2B3D)" />
        <stop offset="100%" stop-color="var(--nn-brand-metal-side, #2F4256)" />
      </linearGradient>
      <linearGradient
        id="nn-brand-instrument-metal-sidewall"
        x1="144"
        y1="176"
        x2="310"
        y2="390"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0%" stop-color="var(--nn-brand-metal-deep, #1D2B3D)" />
        <stop offset="48%" stop-color="var(--nn-brand-metal-side, #2F4256)" />
        <stop offset="78%" stop-color="var(--nn-brand-metal-mid, #8094A5)" />
        <stop offset="100%" stop-color="var(--nn-brand-metal-deep, #1D2B3D)" />
      </linearGradient>
    </defs>

    <circle
      class="nn-brand-instrument__halo"
      cx="260"
      cy="260"
      r="232"
      fill="url(#nn-brand-instrument-halo)"
    />

    <g
      class="nn-brand-instrument__reference"
      fill="none"
      stroke="var(--nn-brand-orbit-secondary, #E6E8EB)"
      stroke-linecap="round"
      stroke-opacity="0.2"
    >
      <circle cx="260" cy="260" r="224" stroke-width="1" stroke-dasharray="1 18" />
      <path d="M260 18V42M260 478V502M18 260H42M478 260H502" stroke-width="1.5" />
      <path d="M72 72L88 88M432 72L416 88M72 448L88 432M432 448L416 432" stroke-width="1" />
    </g>

    <g
      class="nn-brand-instrument__orbit nn-brand-instrument__orbit--cyan"
      fill="none"
      stroke="#22C7D6"
      stroke-linecap="round"
    >
      <ellipse
        cx="260"
        cy="260"
        rx="211"
        ry="116"
        transform="rotate(-24 260 260)"
        stroke-width="6"
        stroke-opacity="0.12"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="211"
        ry="116"
        transform="rotate(-24 260 260)"
        stroke-width="3.2"
        stroke-opacity="0.9"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="211"
        ry="116"
        transform="rotate(-24 260 260)"
        stroke-width="1"
        stroke-opacity="0.46"
        stroke-dasharray="1 16"
      />
      <circle cx="260" cy="144" r="4.25" fill="#22C7D6" stroke="none" />
      <circle cx="471" cy="260" r="2.5" fill="#22C7D6" stroke="none" opacity="0.8" />
    </g>

    <g
      class="nn-brand-instrument__orbit nn-brand-instrument__orbit--silver"
      fill="none"
      stroke="var(--nn-brand-orbit-secondary, #E6E8EB)"
      stroke-linecap="round"
    >
      <ellipse
        cx="260"
        cy="260"
        rx="158"
        ry="201"
        transform="rotate(38 260 260)"
        stroke-width="5"
        stroke-opacity="0.1"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="158"
        ry="201"
        transform="rotate(38 260 260)"
        stroke-width="2.5"
        stroke-opacity="0.72"
        stroke-dasharray="8 14"
      />
      <ellipse
        cx="260"
        cy="260"
        rx="158"
        ry="201"
        transform="rotate(38 260 260)"
        stroke-width="0.9"
        stroke-opacity="0.4"
        stroke-dasharray="1 11"
      />
      <circle cx="260" cy="59" r="3.5" fill="var(--nn-brand-orbit-secondary, #E6E8EB)" stroke="none" />
      <circle
        cx="418"
        cy="260"
        r="2.25"
        fill="var(--nn-brand-orbit-secondary, #E6E8EB)"
        stroke="none"
        opacity="0.8"
      />
    </g>

    <g
      class="nn-brand-instrument__core"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle
        class="nn-brand-instrument__core-sidewall"
        cx="260"
        cy="260"
        r="103"
        transform="translate(-6 5)"
        stroke="url(#nn-brand-instrument-metal-sidewall)"
        stroke-width="16"
        vector-effect="non-scaling-stroke"
      />
      <circle
        class="nn-brand-instrument__core-frame"
        cx="260"
        cy="260"
        r="103"
        stroke="url(#nn-brand-instrument-metal-face)"
        stroke-width="9"
        vector-effect="non-scaling-stroke"
      />
      <path
        class="nn-brand-instrument__core-brandmark"
        d="M 230 292 V 228 L 290 292 V 228"
        stroke="var(--nn-brand-lockup-structure, #FFFFFF)"
        stroke-width="9"
        vector-effect="non-scaling-stroke"
      />
      <path
        class="nn-brand-instrument__core-brandmark-inlay"
        d="M 230 228 L 290 292"
        stroke="var(--nn-brand-cyan, #22C7D6)"
        stroke-width="5.5"
        stroke-linecap="butt"
        vector-effect="non-scaling-stroke"
      />
    </g>
  </svg>
</div>
