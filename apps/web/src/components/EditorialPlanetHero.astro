---
import type { ChartResult } from '@natalnode/contracts';
import EducationalChartInstrument from '@/features/learn/EducationalChartInstrument';
import type { ChartPresentationPolicy } from '@/core/chart/chart-presentation-policy';
import type { SupportedLocale } from '@/lib/localization';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  titleId?: string;
  chart: ChartResult;
  locale: SupportedLocale;
  presentationPolicy: ChartPresentationPolicy;
}

const {
  eyebrow,
  title,
  description,
  titleId = 'editorial-hero-title',
  chart,
  locale,
  presentationPolicy
} = Astro.props;
---

<section class="nn-editorial-hero" aria-labelledby={titleId}>
  <div class="nn-editorial-hero__content">
    <p class="nn-eyebrow">{eyebrow}</p>
    <h1 class="nn-type-page-title mt-3" id={titleId}>{title}</h1>
    <p class="nn-type-body mt-4 max-w-2xl">{description}</p>
  </div>

  <div class="nn-editorial-hero__media">
    <EducationalChartInstrument
      client:only="react"
      chart={chart}
      locale={locale}
      presentationPolicy={presentationPolicy}
    />
  </div>
</section>
