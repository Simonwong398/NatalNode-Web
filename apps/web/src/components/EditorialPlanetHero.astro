---
import NatalNodeBrandInstrument from '@/components/brand/NatalNodeBrandInstrument.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  titleId?: string;
}

const {
  eyebrow,
  title,
  description,
  titleId = 'editorial-hero-title'
} = Astro.props;
---

<section class="nn-editorial-hero" aria-labelledby={titleId}>
  <div class="nn-editorial-hero__content">
    <p class="nn-eyebrow">{eyebrow}</p>
    <h1 class="nn-type-page-title mt-3" id={titleId}>{title}</h1>
    <p class="nn-type-body mt-4 max-w-2xl">{description}</p>
  </div>

  <div class="nn-editorial-hero__media" aria-hidden="true">
    <NatalNodeBrandInstrument class="nn-editorial-hero__instrument" />
  </div>
</section>
