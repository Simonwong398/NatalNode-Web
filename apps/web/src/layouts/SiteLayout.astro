---
import Container from '@/components/layout/Container.astro';
import AuthSessionControl from '@/components/AuthSessionControl.astro';
import SeoHead from '@/components/SeoHead.astro';
import StructuredData from '@/components/StructuredData.astro';
import { DEFAULT_ROBOTS, SITE_NAME, SITE_ORIGIN, type SeoMetadata } from '@/lib/seo';
import '@/styles/global.css';

type ShellMode = 'editorial' | 'observatory';

interface Props {
  seo: SeoMetadata;
  mode?: ShellMode;
  structuredData?: Record<string, unknown>;
}

const { seo, mode, structuredData } = Astro.props;
const currentPath = Astro.url.pathname;
const isLearnPage = currentPath.startsWith('/learn');
const isToolsPage = currentPath.startsWith('/tools');
const isVaultPage = currentPath.startsWith('/vault');
const isAuthPage = currentPath.startsWith('/auth');
const isCalculatePage = currentPath === '/';
const shellMode: ShellMode = mode ?? (isLearnPage || isToolsPage || isAuthPage ? 'editorial' : 'observatory');
const robots = seo.robots ?? DEFAULT_ROBOTS;
const websiteStructuredData = robots === 'index,follow'
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_ORIGIN }
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {websiteStructuredData && <StructuredData data={websiteStructuredData} />}
    {structuredData && <StructuredData data={structuredData} />}
    <script is:inline>
      (() => {
        const getDaypart = (hour) => {
          if (hour >= 5 && hour < 9) return 'dawn';
          if (hour >= 9 && hour < 17) return 'day';
          if (hour >= 17 && hour < 21) return 'dusk';
          return 'night';
        };

        const updateTemporalAmbient = () => {
          const now = new Date();
          const hour = now.getHours();

          document.documentElement.dataset.nnDaypart = getDaypart(hour);
        };

        updateTemporalAmbient();
        document.addEventListener('DOMContentLoaded', updateTemporalAmbient, { once: true });
        window.setInterval(updateTemporalAmbient, 60000);
      })();
    </script>
    <SeoHead seo={seo} />
  </head>
  <body class:list={['nn-shell', `nn-mode-${shellMode}`]} data-shell-mode={shellMode}>
    <header class="nn-site-header">
      <Container mode="shell" class="nn-site-header__inner">
        <a class="nn-brand" href="/" aria-label="NatalNode home">
          NatalNode
        </a>

        <button
          class="nn-menu-toggle"
          type="button"
          data-mobile-nav-toggle
          aria-controls="primary-navigation"
          aria-expanded="false"
          aria-label="Open navigation"
        >
          <span class="sr-only">Toggle navigation</span>
          <span class="nn-menu-toggle__icon" aria-hidden="true"></span>
        </button>

        <nav
          class="nn-primary-nav"
          id="primary-navigation"
          aria-label="Primary navigation"
          data-mobile-nav
          data-open="false"
        >
          <ul class="nn-primary-nav__list">
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href="/learn/"
                aria-current={isLearnPage ? 'page' : undefined}
              >
                Learn
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href="/tools/"
                aria-current={isToolsPage ? 'page' : undefined}
              >
                Tools
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href="/"
                aria-current={isCalculatePage ? 'page' : undefined}
              >
                Calculate
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href="/vault"
                aria-current={isVaultPage ? 'page' : undefined}
              >
                Vault
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <AuthSessionControl />
            </li>
          </ul>
        </nav>
      </Container>
    </header>

    <slot />
  </body>
</html>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (menuButton && mobileNav) {
    const setMenuOpen = (open: boolean, returnFocus = false): void => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      mobileNav.dataset.open = String(open);

      if (!open && returnFocus) {
        menuButton.focus();
      }
    };

    menuButton.addEventListener('click', () => {
      setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    menuButton.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        setMenuOpen(false, true);
      }
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    mobileNav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuOpen(false, true);
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 768px)');
    desktopQuery.addEventListener('change', () => {
      if (desktopQuery.matches) {
        setMenuOpen(false);
      }
    });
  }
</script>
