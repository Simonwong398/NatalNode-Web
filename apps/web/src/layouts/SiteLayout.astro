---
import Container from '@/components/layout/Container.astro';
import AuthSessionControl from '@/components/AuthSessionControl.astro';
import BrandLockup from '@/components/brand/BrandLockup.astro';
import LanguageSelector from '@/components/LanguageSelector.astro';
import ThemeSwitcher from '@/components/ThemeSwitcher';
import SeoHead from '@/components/SeoHead.astro';
import StructuredData from '@/components/StructuredData.astro';
import {
  getLocalizedPath,
  getLocaleIndependentPath,
  getPresentationLocale
} from '@/lib/localization';
import { getUiMessage, type UiMessageKey } from '@/lib/ui-catalog';
import { DEFAULT_ROBOTS, SITE_NAME, SITE_ORIGIN, type SeoMetadata } from '@/lib/seo';
import '@/styles/global.css';

type ShellMode = 'editorial' | 'observatory';

interface Props {
  seo: SeoMetadata;
  mode?: ShellMode;
  structuredData?: Record<string, unknown>;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  seo,
  mode,
  structuredData,
  ogType,
  articlePublishedTime,
  articleModifiedTime
} = Astro.props;
const currentPath = Astro.url.pathname;
const locale = getPresentationLocale(currentPath, Astro.locals.locale);
const routeIdentity = getLocaleIndependentPath(currentPath);
const localize = (path: string): string => getLocalizedPath(locale, path);
const t = (key: UiMessageKey): string => getUiMessage(locale, key);
const isLearnPage = routeIdentity === '/learn' || routeIdentity.startsWith('/learn/');
const isToolsPage = routeIdentity === '/tools' || routeIdentity.startsWith('/tools/');
const isVaultPage = routeIdentity === '/vault' || routeIdentity.startsWith('/vault/');
const isAuthPage = routeIdentity === '/auth' || routeIdentity.startsWith('/auth/');
const isCommunityPage = routeIdentity === '/community' || routeIdentity.startsWith('/community/');
const isCalculatePage = routeIdentity === '/';
const shellMode: ShellMode = mode ?? (isLearnPage || isToolsPage || isAuthPage || isCommunityPage ? 'editorial' : 'observatory');
const robots = seo.robots ?? DEFAULT_ROBOTS;
const websiteStructuredData = robots === 'index,follow'
  ? { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: SITE_ORIGIN }
  : undefined;
---

<!doctype html>
<html lang={locale} data-locale={locale} data-nn-theme-mode="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {websiteStructuredData && <StructuredData data={websiteStructuredData} />}
    {structuredData && <StructuredData data={structuredData} />}
    <script is:inline>
      (() => {
        const themeStorageKey = 'natalnode.theme-mode';
        const isThemeMode = (value) => value === 'light' || value === 'dark' || value === 'auto';
        const autoLightStartHour = 7;
        const autoDarkStartHour = 19;
        let themeMode = 'auto';
        let hasInitializedTheme = false;

        try {
          const storedMode = window.localStorage.getItem(themeStorageKey);
          if (isThemeMode(storedMode)) themeMode = storedMode;
        } catch {
          // The default automatic theme remains available when storage is blocked.
        }

        const resolveAutoTheme = () => {
          const hour = new Date().getHours();
          return hour >= autoLightStartHour && hour < autoDarkStartHour ? 'light' : 'dark';
        };

        const updateTheme = () => {
          const datasetMode = document.documentElement.dataset.nnThemeMode;
          const activeMode = !hasInitializedTheme
            ? themeMode
            : (isThemeMode(datasetMode) ? datasetMode : themeMode);
          themeMode = activeMode;
          hasInitializedTheme = true;
          const resolvedTheme = activeMode === 'auto' ? resolveAutoTheme() : activeMode;
          document.documentElement.dataset.nnThemeMode = activeMode;
          document.documentElement.dataset.nnTheme = resolvedTheme;
          document.documentElement.style.colorScheme = resolvedTheme;
        };

        updateTheme();

        const getDaypart = (hour) => {
          if (hour >= 5 && hour < 9) return 'dawn';
          if (hour >= 9 && hour < 17) return 'day';
          if (hour >= 17 && hour < 21) return 'dusk';
          return 'night';
        };

        const updateTemporalAmbient = () => {
          const now = new Date();
          const hour = now.getHours();

          document.documentElement.dataset.nnDaypart = getDaypart(hour);
        };

        updateTemporalAmbient();
        document.addEventListener('DOMContentLoaded', updateTemporalAmbient, { once: true });
        document.addEventListener('visibilitychange', updateTheme);
        window.setInterval(() => {
          updateTheme();
          updateTemporalAmbient();
        }, 60000);
      })();
    </script>
    <SeoHead
      seo={seo}
      ogType={ogType}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
    />
  </head>
  <body class:list={['nn-shell', `nn-mode-${shellMode}`]} data-shell-mode={shellMode}>
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 nn-button nn-button--secondary"
      href="#main-content"
    >
      {t('accessibility.skipToMain')}
    </a>
    <header class="nn-site-header">
      <Container mode="shell" class="nn-site-header__inner">
        <BrandLockup href={localize('/')} />

        <div class="nn-site-header__actions">
          <LanguageSelector locale={locale} />
          <ThemeSwitcher locale={locale} client:load />
          <button
            class="nn-menu-toggle"
            type="button"
            data-mobile-nav-toggle
            aria-controls="primary-navigation"
            aria-expanded="false"
            aria-label={t('accessibility.openNavigation')}
            data-open-navigation-label={t('accessibility.openNavigation')}
            data-close-navigation-label={t('accessibility.closeNavigation')}
          >
            <span class="sr-only">{t('accessibility.toggleNavigation')}</span>
            <span class="nn-menu-toggle__icon" aria-hidden="true"></span>
          </button>
        </div>

        <nav
          class="nn-primary-nav"
          id="primary-navigation"
          aria-label={t('accessibility.primaryNavigation')}
          data-mobile-nav
          data-open="false"
        >
          <ul class="nn-primary-nav__list">
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href={localize('/learn/')}
                aria-current={isLearnPage ? 'page' : undefined}
              >
                {t('nav.learn')}
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href={localize('/tools/')}
                aria-current={isToolsPage ? 'page' : undefined}
              >
                {t('nav.tools')}
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href={localize('/')}
                aria-current={isCalculatePage ? 'page' : undefined}
              >
                {t('nav.calculate')}
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href={localize('/vault')}
                aria-current={isVaultPage ? 'page' : undefined}
              >
                {t('nav.vault')}
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <a
                class="nn-nav-link"
                href={localize('/community/')}
                aria-current={isCommunityPage ? 'page' : undefined}
              >
                {t('nav.community')}
              </a>
            </li>
            <li class="nn-primary-nav__item">
              <AuthSessionControl />
            </li>
          </ul>
        </nav>
      </Container>
    </header>

    <div id="main-content">
      <slot />
    </div>

    <footer class="border-t border-natal-border/70">
      <Container mode="shell" class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6">
        <BrandLockup class="nn-footer-brand" href={localize('/')} size={22} />
        <nav aria-label={t('accessibility.trustNavigation')}>
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <li>
              <a
                class="font-semibold text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white"
                href={localize('/about')}
              >
                {t('nav.about')}
              </a>
            </li>
            <li>
              <a
                class="font-semibold text-natal-accent underline decoration-natal-accent/50 underline-offset-4 transition-colors hover:text-white"
                href={localize('/methodology')}
              >
                {t('nav.methodology')}
              </a>
            </li>
          </ul>
        </nav>
      </Container>
    </footer>
  </body>
</html>

<script>
  const menuButton = document.querySelector<HTMLButtonElement>('[data-mobile-nav-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (menuButton && mobileNav) {
    const openNavigationLabel = menuButton.dataset.openNavigationLabel ?? 'Open navigation';
    const closeNavigationLabel = menuButton.dataset.closeNavigationLabel ?? 'Close navigation';
    const setMenuOpen = (open: boolean, returnFocus = false): void => {
      menuButton.setAttribute('aria-expanded', String(open));
      menuButton.setAttribute('aria-label', open ? closeNavigationLabel : openNavigationLabel);
      mobileNav.dataset.open = String(open);

      if (!open && returnFocus) {
        menuButton.focus();
      }
    };

    menuButton.addEventListener('click', () => {
      setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    menuButton.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        setMenuOpen(false, true);
      }
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    mobileNav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenuOpen(false, true);
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 768px)');
    desktopQuery.addEventListener('change', () => {
      if (desktopQuery.matches) {
        setMenuOpen(false);
      }
    });
  }
</script>
